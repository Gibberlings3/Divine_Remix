BEGIN @60000 DESIGNATED 600 // component 600
GROUP @10
REQUIRE_PREDICATE ((!GAME_IS ~iwdee~) AND                          // not for iwdee
                   ((MOD_IS_INSTALLED ~divine_remix.tp2~ ~109~) OR // either we've installed DR's tempus kit
                    (GAME_IS ~bgee bg2ee eet~))) @16               // or we're on the EEs, which have their own
LABEL ~cd_dr_npckit_branwen~

ACTION_IF MOD_IS_INSTALLED ~divine_remix.tp2~ ~109~ BEGIN 
  OUTER_SET kit = (IDS_OF_SYMBOL (~KIT~ ~A#TEMP~)) // DR's tempus
END ELSE BEGIN 
  OUTER_SET kit = (IDS_OF_SYMBOL (~KIT~ ~OHTEMPUS~)) // EE's tempus
END

ACTION_FOR_EACH cre IN branwe branwe5 _branwe _branwe5  O#Bran o#bran25 o#branv ttbran BEGIN

  COPY_EXISTING ~%cre%.cre~ ~override~
    LPF cd_assign_kit_to_cre INT_VAR name = 0 END
    BUT_ONLY IF_EXISTS

END

