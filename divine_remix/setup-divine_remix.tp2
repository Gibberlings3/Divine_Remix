BEGIN @5000 DESIGNATED 50
SUBCOMPONENT @5002
REQUIRE_PREDICATE !GAME_IS ~bgee bg2ee eet iwdee~ @16
GROUP @15
LABEL ~cd_dr_remove_cleric_kits_mod~

LAF cd_mkr INT_VAR remove_orig = 0 STR_VAR class = c END

