BEGIN @40600 DESIGNATED 406
GROUP @13
REQUIRE_PREDICATE NOT FILE_EXISTS_IN_GAME ~a#feral.2da~ @9

// shapeshifters get locked out of all armor, either by the druid flag or their individual kit flag
COPY_EXISTING_REGEXP GLOB ~^.+\.itm$~ ~override~
  READ_BYTE 0x1c type
  PATCH_IF ((type = 2) OR ((type > 59) AND (type < 68))) BEGIN // any armor
    READ_LONG  0x1e use
    PATCH_IF ((use BAND BIT30) = BIT30) BEGIN // if unusable by druids...
      WRITE_BYTE 0x29 (THIS BAND `BIT4)       // removes redundant shapeshifter flag
    END ELSE BEGIN                            // if usable by druids...
      WRITE_BYTE 0x29 (THIS BOR BIT4)         // adds shapeshifter flag
    END
  END
  BUT_ONLY

ACTION_CLEAR_ARRAY cd_clone_spell_array // do this once
LAF cd_clone_spell_bulk STR_VAR source = spcl321 destination = ~a#fera02~ RET_ARRAY cd_clone_spell_array END // enrage (berserker innate)
PRINT @3
INCLUDE ~divine_remix/lib/cd_clone_spell_bulk_last.tpa~

