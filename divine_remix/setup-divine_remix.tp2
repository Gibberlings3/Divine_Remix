BEGIN @1001 DESIGNATED 10 // component 0
SUBCOMPONENT @1000
GROUP @10 GROUP @11 GROUP @13 // GROUP @12

OUTER_SET overwrite = 1
INCLUDE ~divine_remix/lib/new_spells.tph~

