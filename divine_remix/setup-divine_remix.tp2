BACKUP   ~weidu_external/divine_remix/backup~    // location to store files for uninstall purposes
SUPPORT ~https://www.gibberlings3.net/forum/29-divine-remix/~

ALWAYS
  OUTER_SET bio = "-1"
  ACTION_IF NOT VARIABLE_IS_SET cd_divine_remix_always THEN BEGIN
    INCLUDE ~divine_remix/lib/always.tpa~ // defines patch macro
  END
END

VERSION  ~v8 (Beta)~

README   ~divine_remix/readme-divine_remix.html~

ASK_EVERY_COMPONENT

AUTO_TRA ~%tra_path%/%s~
LANGUAGE
  ~English~
  ~english~
  ~divine_remix/languages/english/weidu.tra~
  ~divine_remix/languages/english/game.tra~
LANGUAGE
  ~Francais (by Sanctifer)~
  ~french~
  ~divine_remix/languages/english/weidu.tra~
  ~divine_remix/languages/english/game.tra~
  ~divine_remix/languages/french/weidu.tra~
  ~divine_remix/languages/french/game.tra~
/*
LANGUAGE
  ~Polski (by yarpen)~
  ~polski~
  ~divine_remix/languages/english/weidu.tra~
  ~divine_remix/languages/english/game.tra~
  ~divine_remix/languages/polski/weidu.tra~
  ~divine_remix/languages/polski/game.tra~
LANGUAGE
  ~Czech (by Neferit, Katie, and Ondrej)~
  ~czech~
  ~divine_remix/languages/english/weidu.tra~
  ~divine_remix/languages/english/game.tra~
  ~divine_remix/languages/czech/weidu.tra~
  ~divine_remix/languages/czech/game.tra~
*/

