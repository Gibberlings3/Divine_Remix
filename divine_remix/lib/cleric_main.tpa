/////                                                  \\\\\
///// universal elements for kit priests               \\\\\
/////                                                  \\\\\

// only if alignments not already shifted
ACTION_IF NOT FILE_CONTAINS_EVALUATED (~alignment.2da~ ~^LATHANDER[ %TAB%]+1[ %TAB%]+0[ %TAB%]+0[ %TAB%]+1[ %TAB%]+1[ %TAB%]+0[ %TAB%]+1[ %TAB%]+0[ %TAB%]+0~) THEN BEGIN

  COPY_EXISTING ~alignmnt.2da~ ~override~
    REPLACE_TEXTUALLY ~^TALOS[ %TAB%]+.+~     ~TALOS     0 0 0 0 0 1 0 1 1~
    REPLACE_TEXTUALLY ~^HELM[ %TAB%]+.+~      ~HELM      1 1 1 0 1 0 0 0 0~
    REPLACE_TEXTUALLY ~^LATHANDER[ %TAB%]+.+~ ~LATHANDER 1 0 0 1 1 0 1 0 0~
    PRETTY_PRINT_2DA
    BUT_ONLY

  ACTION_IF GAME_IS ~soa bg2 tob bgt~ THEN BEGIN // temple stronghold stuff - accounting for changed alignments for temple kits

    COMPILE ~divine_remix/dlg/temple.d~

    COPY_EXISTING ~ar0900.bcs~ ~override~
      DECOMPILE_AND_PATCH BEGIN
        REPLACE_TEXTUALLY ~Global("GaalSpoke","AR0900",1)~ ~False()~ // disable existing spawns
        APPEND_FILE ~divine_remix/baf/ar0900.baf~                    // add new spawns
      END
      BUT_ONLY

    COPY_EXISTING ~ar0901.bcs~ ~override~
      DECOMPILE_AND_PATCH BEGIN
        REPLACE_TEXTUALLY ~Global("TelwynSpawn","GLOBAL",0)~ ~False()~ // disable existing spawns
        APPEND_FILE ~divine_remix/baf/ar0901.baf~                      // add new spawns
      END
      BUT_ONLY

    COPY_EXISTING ~ar0902.bcs~ ~override~
      DECOMPILE_AND_PATCH BEGIN
        REPLACE_TEXTUALLY ~Global("SainSpawn","GLOBAL",0)~ ~False()~ // disable existing spawns
        APPEND_FILE ~divine_remix/baf/ar0902.baf~                    // add new spawns
      END
      BUT_ONLY

    COPY_EXISTING ~ar0904.bcs~ ~override~
      DECOMPILE_AND_PATCH BEGIN
        REPLACE_TEXTUALLY ~Global("YarrylSpawn","GLOBAL",0)~ ~False()~ // disable existing spawns
        APPEND_FILE ~divine_remix/baf/ar0904.baf~                      // add new spawns
      END
      BUT_ONLY

  END

END

ACTION_IF !cd_dr_conventional BEGIN
  OUTER_SPRINT clabpr02_newhelp @10177
  OUTER_SPRINT clabpr03_newhelp @10194
  OUTER_SPRINT clabpr04_newhelp @10178
  OUTER_SPRINT ohtempus_newhelp @10902
  OUTER_SPRINT ohtyr_newhelp    @13310
END
  
// new descripts
COPY_EXISTING ~kitlist.2da~ ~override~ // look for kit descripts
  SPRINT mixed_match @10154 // Priest
  SPRINT lower_match @10134 // priest
  SPRINT upper_match @10135 // PRIEST
  COUNT_2DA_ROWS 9 rows
  FOR (index = 0 ; index < rows ; ++index) BEGIN
    READ_2DA_ENTRY index 5 8 clab
    TO_LOWER clab
    PATCH_IF ("%clab%" STRING_COMPARE_CASE "clabpr02" = 0) BEGIN // talos
      SPRINT mixed_replace @10136 // Stormlord
      SPRINT lower_replace @10137 // stormlord
      SPRINT upper_replace @10138 // STORMLORD
      LAUNCH_PATCH_MACRO cd_descript_replace
    END ELSE
    PATCH_IF  ("%clab%" STRING_COMPARE_CASE "clabpr03" = 0) BEGIN // helm
      SPRINT mixed_replace @10139 // Watcher
      SPRINT lower_replace @10140 // watcher
      SPRINT upper_replace @10141 // WATCHER
      LAUNCH_PATCH_MACRO cd_descript_replace
    END ELSE
    PATCH_IF  ("%clab%" STRING_COMPARE_CASE "clabpr04" = 0) BEGIN // lathander
      SPRINT mixed_replace @10142 // Morninglord
      SPRINT lower_replace @10143 // morninglord
      SPRINT upper_replace @10144 // MORNINGLORD
      LAUNCH_PATCH_MACRO cd_descript_replace
    END ELSE
    PATCH_IF  ("%clab%" STRING_COMPARE_CASE "ohtempus" = 0) BEGIN // tempus
      SPRINT mixed_replace @10145 // Battleguard
      SPRINT lower_replace @10146 // battleguard
      SPRINT upper_replace @10147 // BATTLEGUARD
      LAUNCH_PATCH_MACRO cd_descript_replace
    END ELSE
    PATCH_IF  ("%clab%" STRING_COMPARE_CASE "ohtyr" = 0) BEGIN // tyr
      SPRINT mixed_replace @10148 // Holy Justice
      SPRINT lower_replace @10149 // holy justice
      SPRINT upper_replace @10150 // HOLY JUSTICE
      LAUNCH_PATCH_MACRO cd_descript_replace
    END
  END
  BUT_ONLY

/////                                                  \\\\\
///// Changes to HLAs and holy symbols for ToB         \\\\\
/////                                                  \\\\\

ACTION_IF !enhanced_edition AND game_includes_tob THEN BEGIN // ees already do this so only proceed for obg2

  COPY_EXISTING ~belt12.itm~ ~override~ // Lathander Holy symbol
    SAY UNIDENTIFIED_DESC @10183
    SAY DESC @10183
    WRITE_BYTE 0x1e ((THIS BAND 0b11000000) BOR BIT1) // preserve bard/cleric flags, blank alignment restrictions except no evil

  COPY_EXISTING ~belt13.itm~ ~override~ // Helm Holy Symbol
    SAY UNIDENTIFIED_DESC @10187
    SAY DESC @10187
    WRITE_BYTE 0x1e ((THIS BAND 0b11000000) BOR BIT0) // preserve bard/cleric flags, blank alignment restrictions except no chaotic

  COPY_EXISTING ~belt14.itm~ ~override~ // Talos holy symbol
    SAY UNIDENTIFIED_DESC @10182
    SAY DESC @10182
    WRITE_BYTE 0x1e ((THIS BAND 0b11000000) BOR (BIT2 + BIT4)) // preserve bard/cleric flags, blank alignment restrictions except no lawful/good

  // Change the way the script works to avoid usable issues with holy symbols. It is mostly for
  // Chaotic neutral and lawful evil clerics - BG2 fixpack is needed.
  COPY_EXISTING ~baldur.bcs~   ~override~
                ~baldur25.bcs~ ~override~
    DECOMPILE_AND_PATCH BEGIN
      REPLACE_EVALUATE CASE_INSENSITIVE // updating helm
        ~\(Alignment(Player\)\([1-6]\)\(,MASK_GENEUTRAL)\)[ %TAB%%LNL%%MNL%%WNL%]+\(HasItem("CDHLYSYM",Player[1-6])\)~
      BEGIN
        PATCH_IF MATCH2 = 1 BEGIN
          SPRINT p1check ~GlobalGT("CDWorkingForHelm","GLOBAL",0)~
        END ELSE BEGIN
          SPRINT p1check ~False()~
        END
      END ~%MATCH4%
           !Kit(Player%MATCH2%,GODLATHANDER)
           OR(5)
             %p1check%
             Alignment(Player%MATCH2%,LAWFUL_NEUTRAL)
             Alignment(Player%MATCH2%,NEUTRAL)
             Alignment(Player%MATCH2%,LAWFUL_EVIL)
             Kit(Player%MATCH2%,GODHELM)~
      REPLACE_EVALUATE CASE_INSENSITIVE // updating lathander
        ~\(Alignment(Player\)\([1-6]\)\(,MASK_GOOD)\)[ %TAB%%LNL%%MNL%%WNL%]+\(HasItem("CDHLYSYM",Player[1-6])\)~
      BEGIN
        PATCH_IF MATCH2 = 1 BEGIN
          SPRINT p1check ~GlobalGT("CDWorkingForLathander","GLOBAL",0)~
        END ELSE BEGIN
          SPRINT p1check ~False()~
        END
      END ~%MATCH4%
           !Kit(Player%MATCH2%,GODHELM)
           OR(3)
             %p1check%
             Alignment(Player%MATCH2%,MASK_GOOD)
             Kit(Player%MATCH2%,GODLATHANDER)~
      REPLACE_TEXTUALLY CASE_INSENSITIVE // updating talos (no special p1 case here
        ~\(Alignment(Player\)\([1-6]\)\(,MASK_EVIL)\)[ %TAB%%LNL%%MNL%%WNL%]+\(HasItem("CDHLYSYM",Player[1-6])\)~
        ~\4
         OR(4)
           Alignment(Player\2,CHAOTIC_NEUTRAL)
           Alignment(Player\2,NEUTRAL_EVIL)
           Alignment(Player\2,CHAOTIC_EVIL)
           Kit(Player\2,GODTALOS)~
    END
    BUT_ONLY

END

/////                                                  \\\\\
///// misc                                             \\\\\
/////                                                  \\\\\

// added at Idobek's request for NPC Kit compatibility
COPY_EXISTING ~ikitano1.spl~ ~override~
  SAY 0x9e @10101
  IF_EXISTS

/////                                                  \\\\\
///// assign kits                                      \\\\\
/////                                                  \\\\\

OUTER_SET kit = (IDS_OF_SYMBOL (~KIT~ ~GODTALOS~)) // talos
OUTER_SPRINT kitname @10136 // ~Stormlord~
ACTION_FOR_EACH cre IN acolyte1 bhnalla c6cler3 cldad cltalp01 ltalos /*nalla*/ scyarryl talmiss talmiss2 talvilon vvpriest yssold16 BEGIN // nalla is a bard, not a priest...

  COPY_EXISTING ~%cre%.cre~ ~override~
    LPF cd_assign_kit_to_cre END
    BUT_ONLY IF_EXISTS

END

// Stormherald Nallabir
ACTION_IF MOD_IS_INSTALLED "song_and_silence.tp2" 3 BEGIN
  COPY_EXISTING ~nalla.cre~ ~override~
    WRITE_LONG  0x244 0
    WRITE_SHORT 0x246 (IDS_OF_SYMBOL (~KIT~ ~A!CHORISTER~))
    BUT_ONLY IF_EXISTS
END

OUTER_SET kit = (IDS_OF_SYMBOL (~KIT~ ~GODHELM~)) // helm
OUTER_SPRINT kitname @10139 // ~Watcher~
ACTION_FOR_EACH cre IN acolyte3 bhelm bhoisig c6cler2 helmbyr helmpr oisig sctelwyn nalin shugod01 shugod02 shugar01 ntprihel s#helm01 BEGIN

  COPY_EXISTING ~%cre%.cre~ ~override~
    LPF cd_assign_kit_to_cre END
    BUT_ONLY IF_EXISTS

END

OUTER_SET kit = (IDS_OF_SYMBOL (~KIT~ ~GODLATHANDER~)) // Lathander
OUTER_SPRINT kitname @10142 // ~Morninglord~
ACTION_FOR_EACH cre IN acolyte2 amtcle01 amtcler0 arenthis arval bharval c6cler1 cllatp01 cscleric dawnmas latlara scsain BEGIN

  COPY_EXISTING ~%cre%.cre~ ~override~
    LPF cd_assign_kit_to_cre END
    BUT_ONLY IF_EXISTS

END

OUTER_SET kit = (IDS_OF_SYMBOL (~KIT~ ~OHTYR~)) // tyr
OUTER_SPRINT kitname @10148 // ~Holy Justice~
ACTION_IF kit > 0 THEN BEGIN

  ACTION_FOR_EACH cre IN ohdcru01 ohdcru02 ohdlufc1 ohdlumc1 ohdneo03 ohdneo04 ohdppe01 ohdppe02 ohdrdef ohdtree1 BEGIN

    COPY_EXISTING ~%cre%.cre~ ~override~
      LPF cd_assign_kit_to_cre END
      BUT_ONLY IF_EXISTS

  END

END

OUTER_SET kit = (IDS_OF_SYMBOL (~KIT~ ~OHTEMPUS~)) // tempus
OUTER_SPRINT kitname @10145 // ~Battleguard~
ACTION_IF kit > 0 THEN BEGIN

  ACTION_FOR_EACH cre IN kpchap01 everard accalia BEGIN

    COPY_EXISTING ~%cre%.cre~ ~override~
      LPF cd_assign_kit_to_cre END
      BUT_ONLY IF_EXISTS

  END

END
