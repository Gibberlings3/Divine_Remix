/////                                                  \\\\\
///// CD_EXTEND-O-MATIC, patent pending                \\\\\
/////                                                  \\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\

INCLUDE ~divine_remix/lib/cd_extend-o-matic.tpa~

/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////                                                  \\\\\
///// cd_dr_holy_weapon                                \\\\\
/////                                                  \\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\

// utilizes game_check vars and the extend-o-matic
DEFINE_ACTION_FUNCTION cd_dr_holy_weapon 
  STR_VAR item = ""
          name = ""
          desc = ""
BEGIN

  COPY ~divine_remix/spl/holy_weapon.spl~ ~override/%item%.spl~  // Lathander's Mace (innate spell)
    SAY_EVALUATED 0x08 ~%name%~
    SAY_EVALUATED 0x0c ~%name%~
    SAY_EVALUATED 0x50 ~%desc%~
    SAY_EVALUATED 0x54 ~%desc%~
    LPF CD_EXTEND-O-MATIC INT_VAR base_dur = 6 step_dur = 0 step_size = 1 level_cap = dr_level_cap END // can't do durations automatically since visual is also 6 seconds
    PATCH_IF !game_is_iwdee BEGIN // have to create extra headers for +4 and +5 weapons even though duration doesn't increase
      LPF CD_EXTEND-O-MATIC INT_VAR dur_special = 1 step_dur = 0 step_size = 1 level_cap = 21 END // just create a level 21 header (no more duration increases)
      LPF CD_EXTEND-O-MATIC INT_VAR dur_special = 1 step_dur = 0 step_size = 5 level_cap = 26 END // just create a level 26 header (no more duration increases)
      LPF ALTER_EFFECT INT_VAR header = 20 match_opcode = 111 duration = 120 STR_VAR resource = EVAL ~%item%4~ END // set created item
      LPF ALTER_EFFECT INT_VAR header = 21 match_opcode = 111 duration = 120 STR_VAR resource = EVAL ~%item%5~ END // set created item
    END
    FOR (index = 0 ; index < dr_level_cap ; ++index) BEGIN 
      SET wpn = index / 5 // using WeiDU's whole number rounding to our advantage
      LPF ALTER_EFFECT INT_VAR header = index match_opcode = 111 duration = (6 * (index + 1)) STR_VAR resource = EVAL ~%item%%wpn%~ END // set created item
    END 

  OUTER_FOR (index = 0 ; index < 6 ; ++index) BEGIN
  
    COPY ~Divine_Remix/itm/%item%.itm~ ~override/%item%%index%.itm~  // Lathander's Mace +0
      PATCH_IF !index BEGIN // just do the name/desc for +0
        SAY_EVALUATED 0x08 ~%name%~
        SAY_EVALUATED 0x0c ~%name%~
        SAY_EVALUATED 0x50 ~%desc%~
        SAY_EVALUATED 0x54 ~%desc%~
        READ_SHORT    0x84 b_speed // get base item weapon speed
      END ELSE BEGIN   
        SAY_EVALUATED 0x08 ~%name% +%index%~ // name it weapon +1 if we're not on the non-magical version
        SAY_EVALUATED 0x0c ~%name% +%index%~
        SAY_EVALUATED 0x50 ~%name% +%index%%WNL%%desc%~
        SAY_EVALUATED 0x54 ~%name% +%index%%WNL%%desc%~
        WRITE_LONG 0x60 index // enhcantment
        WRITE_SHORT 0x86 (THIS + index) // to-hit bonus
        WRITE_SHORT 0x8c (THIS + index) // damage bonus
        PATCH_IF (index > b_speed) BEGIN SET speed = 0 END ELSE BEGIN SET speed = b_speed - index END   
        WRITE_SHORT 0x84 speed // speed
      END  

  END
  
END  

/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////                                                  \\\\\
///// cd_kit_sphere_v9                                 \\\\\
/////                                                  \\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\

DEFINE_ACTION_FUNCTION cd_kit_sphere_v9
  INT_VAR 
    string                  = 0
    cr_exception            = 0
  STR_VAR
    table                   = clabpr01
    class                   = cleric
    all                     = none
    animal                  = none
    astral                  = none
    chaos                   = none
    charm                   = none
    combat                  = none
    creation                = none
    divination              = none
    elemental               = none
    elemental_air           = none
    elemental_earth         = none
    elemental_fire          = none
    elemental_water         = none
    guardian                = none
    healing                 = none
    law                     = none
    necromantic             = none
    necromantic_restorative = none
    numbers                 = none
    plant                   = none
    protection              = none
    summoning               = none
    sun                     = none
    thoughts                = none
    time                    = none
    travelers               = none
    war                     = none
    wards                   = none
    weather                 = none
BEGIN
 
  ACTION_IF ((FILE_EXISTS_IN_GAME ~%table%.2da~) OR (cr_exception = 2)) THEN BEGIN // sanity check
      
    // don't mess with it if spell sphere spells already exist    
    ACTION_IF ((FILE_EXISTS ~weidu_external/divine_remix/sphere/allowed_%table%.2da~) OR (cr_exception = 2)) THEN BEGIN // in mode 2, don't mess with the table
    
      OUTER_SET cd_adjust_table = 0
      
    END ELSE BEGIN 
    
      OUTER_SET cd_adjust_table = 1
      
      COPY_EXISTING ~%table%.2da~ ~override~ // extends CLAB to level 50 if needed
        PATCH_IF (SOURCE_SIZE > 0) BEGIN
          LAUNCH_PATCH_MACRO ~remove_blank_lines_from_eof~ // remove eof blank lines
          REPLACE_TEXTUALLY ~[%WNL%%MNL%]+~ ~%LNL%~
          REPLACE_TEXTUALLY ~\(1[ %TAB%]+2[ %TAB%]+3[ %TAB%]+4[ %TAB%]+5[ %TAB%]+6[ %TAB%]+7[ %TAB%]+8[ %TAB%]+9[ %TAB%]+10[ %TAB%]+11[ %TAB%]+12[ %TAB%]+13[ %TAB%]+14[ %TAB%]+15[ %TAB%]+16[ %TAB%]+17[ %TAB%]+18[ %TAB%]+19[ %TAB%]+20[ %TAB%]+21[ %TAB%]+22[ %TAB%]+23[ %TAB%]+24[ %TAB%]+25[ %TAB%]+26[ %TAB%]+27[ %TAB%]+28[ %TAB%]+29[ %TAB%]+30[ %TAB%]+31[ %TAB%]+32[ %TAB%]+33[ %TAB%]+34[ %TAB%]+35[ %TAB%]+36[ %TAB%]+37[ %TAB%]+38[ %TAB%]+39\)\([ %TAB%]+\)40[ %TAB%]*~
            ~\1\240\241\242\243\244\245\246\247\248\249\250~
          REPLACE_TEXTUALLY ~^\(ABILITY[0-9A-Z]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+\)\([ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%%LNL%]+\)[ %TAB%]*$~
            ~\1\2\2~
        END
        UNLESS ~41[ %TAB%]+42[ %TAB%]+43[ %TAB%]+44[ %TAB%]+45[ %TAB%]+46[ %TAB%]+47[ %TAB%]+48[ %TAB%]+49[ %TAB%]+50~
        BUT_ONLY
        
    END    
    
<<<<<<<<./inline/temp.tpa
>>>>>>>>
  
    OUTER_SPRINT sphere_major ~%sphere_major_orig%~ // initialize strings
    OUTER_SPRINT sphere_minor ~%sphere_minor_orig%~
    OUTER_SPRINT sphere_none  ~%sphere_none_orig%~
    
    COPY ~./inline/temp.tpa~ ~weidu_external/divine_remix/spheres/temp.tpa~
      PATCH_IF (("%all%" STRING_COMPARE_CASE "major" = 0) OR (cr_exception = 1)) THEN BEGIN 
        SPRINT sphere_major "%sphere_major%, %sphere_al%" 
        PATCH_IF ("%all%" STRING_COMPARE_CASE "major" = 0) BEGIN APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_al_major.2da~ END
      END ELSE
      PATCH_IF ("%all%" STRING_COMPARE_CASE "minor" = 0)                     THEN BEGIN 
        SPRINT sphere_minor "%sphere_minor%, %sphere_al%"  
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_al_minor.2da~
      END ELSE BEGIN SPRINT sphere_none "%sphere_none%, %sphere_al%" END
      
      PATCH_IF (("%animal%" STRING_COMPARE_CASE "major" = 0) OR (cr_exception = 1)) THEN BEGIN 
        SPRINT sphere_major "%sphere_major%, %sphere_an%" 
        PATCH_IF ("%animal%" STRING_COMPARE_CASE "major" = 0) BEGIN APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_an_major.2da~ END
      END ELSE 
      PATCH_IF ("%animal%" STRING_COMPARE_CASE "minor" = 0)                  THEN BEGIN 
        SPRINT sphere_minor "%sphere_minor%, %sphere_an%"  
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_an_minor.2da~
      END ELSE BEGIN SPRINT sphere_none "%sphere_none%, %sphere_an%" END
      
      PATCH_IF ("%astral%" STRING_COMPARE_CASE "major" = 0)                  THEN BEGIN 
        SPRINT sphere_major "%sphere_major%, %sphere_as%" 
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_as_major.2da~
      END ELSE
      PATCH_IF ("%astral%" STRING_COMPARE_CASE "minor" = 0)                  THEN BEGIN 
        SPRINT sphere_minor "%sphere_minor%, %sphere_as%"  
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_as_minor.2da~
      END ELSE BEGIN SPRINT sphere_none "%sphere_none%, %sphere_as%" END
      
      PATCH_IF ("%chaos%" STRING_COMPARE_CASE "major" = 0)                   THEN BEGIN 
        SPRINT sphere_major "%sphere_major%, %sphere_cs%" 
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_cs_major.2da~
      END ELSE
      PATCH_IF ("%chaos%" STRING_COMPARE_CASE "minor" = 0)                   THEN BEGIN 
        SPRINT sphere_minor "%sphere_minor%, %sphere_cs%"   
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_cs_minor.2da~
      END ELSE BEGIN SPRINT sphere_none "%sphere_none%, %sphere_cs%" END
      
      PATCH_IF ("%charm%" STRING_COMPARE_CASE "major" = 0)                   THEN BEGIN 
        SPRINT sphere_major "%sphere_major%, %sphere_cm%" 
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_cm_major.2da~
      END ELSE
      PATCH_IF ("%charm%" STRING_COMPARE_CASE "minor" = 0)                   THEN BEGIN 
        SPRINT sphere_minor "%sphere_minor%, %sphere_cm%"   
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_cm_minor.2da~
      END ELSE BEGIN SPRINT sphere_none "%sphere_none%, %sphere_cm%" END
      
      PATCH_IF ("%combat%" STRING_COMPARE_CASE "major" = 0)                  THEN BEGIN 
        SPRINT sphere_major "%sphere_major%, %sphere_co%" 
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_co_major.2da~
      END ELSE
      PATCH_IF ("%combat%" STRING_COMPARE_CASE "minor" = 0)                  THEN BEGIN 
        SPRINT sphere_minor "%sphere_minor%, %sphere_co%"   
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_co_minor.2da~
      END ELSE BEGIN SPRINT sphere_none "%sphere_none%, %sphere_co%" END
      
      PATCH_IF ("%creation%" STRING_COMPARE_CASE "major" = 0)                THEN BEGIN 
        SPRINT sphere_major "%sphere_major%, %sphere_cr%"  
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_cr_major.2da~
      END ELSE
      PATCH_IF ("%creation%" STRING_COMPARE_CASE "minor" = 0)                THEN BEGIN 
        SPRINT sphere_minor "%sphere_minor%, %sphere_cr%"   
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_cr_minor.2da~
      END ELSE BEGIN SPRINT sphere_none "%sphere_none%, %sphere_cr%" END
      
      PATCH_IF ("%divination%" STRING_COMPARE_CASE "major" = 0)              THEN BEGIN 
        SPRINT sphere_major "%sphere_major%, %sphere_di%"  
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_di_major.2da~
      END ELSE
      PATCH_IF ("%divination%" STRING_COMPARE_CASE "minor" = 0)              THEN BEGIN 
        SPRINT sphere_minor "%sphere_minor%, %sphere_di%"   
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_di_minor.2da~
      END ELSE BEGIN SPRINT sphere_none "%sphere_none%, %sphere_di%" END
      
      PATCH_IF ("%elemental%" STRING_COMPARE_CASE "major" = 0)               THEN BEGIN 
        SPRINT sphere_major "%sphere_major%, %sphere_ex%"  
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_ex_major.2da~
      END ELSE
      PATCH_IF ("%elemental%" STRING_COMPARE_CASE "minor" = 0)               THEN BEGIN 
        SPRINT sphere_minor "%sphere_minor%, %sphere_ex%"   
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_ex_minor.2da~
      END ELSE BEGIN SPRINT sphere_none "%sphere_none%, %sphere_ex%" END
      
      PATCH_IF ("%elemental_air%" STRING_COMPARE_CASE "major" = 0)           THEN BEGIN 
        SPRINT sphere_major "%sphere_major%, %sphere_ea%"  
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_ea_major.2da~
      END ELSE
      PATCH_IF ("%elemental_air%" STRING_COMPARE_CASE "minor" = 0)           THEN BEGIN 
        SPRINT sphere_minor "%sphere_minor%, %sphere_ea%"   
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_ea_minor.2da~
      END ELSE BEGIN SPRINT sphere_none "%sphere_none%, %sphere_ea%" END
      
      PATCH_IF ("%elemental_earth%" STRING_COMPARE_CASE "major" = 0)         THEN BEGIN 
        SPRINT sphere_major "%sphere_major%, %sphere_ee%"  
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_ee_major.2da~
      END ELSE
      PATCH_IF ("%elemental_earth%" STRING_COMPARE_CASE "minor" = 0)         THEN BEGIN 
        SPRINT sphere_minor "%sphere_minor%, %sphere_ee%"   
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_ee_minor.2da~
      END ELSE BEGIN SPRINT sphere_none "%sphere_none%, %sphere_ee%" END
      
      PATCH_IF ("%elemental_fire%" STRING_COMPARE_CASE "major" = 0)          THEN BEGIN 
        SPRINT sphere_major "%sphere_major%, %sphere_ef%"  
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_ef_major.2da~
      END ELSE
      PATCH_IF ("%elemental_fire%" STRING_COMPARE_CASE "minor" = 0)          THEN BEGIN 
        SPRINT sphere_minor "%sphere_minor%, %sphere_ef%"   
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_ef_minor.2da~
      END ELSE BEGIN SPRINT sphere_none "%sphere_none%, %sphere_ef%" END
      
      PATCH_IF ("%elemental_water%" STRING_COMPARE_CASE "major" = 0)         THEN BEGIN 
        SPRINT sphere_major "%sphere_major%, %sphere_ew%"  
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_ew_major.2da~
      END ELSE
      PATCH_IF ("%elemental_water%" STRING_COMPARE_CASE "minor" = 0)         THEN BEGIN 
        SPRINT sphere_minor "%sphere_minor%, %sphere_ew%"   
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_ew_minor.2da~
      END ELSE BEGIN SPRINT sphere_none "%sphere_none%, %sphere_ew%" END
      
      PATCH_IF ("%guardian%" STRING_COMPARE_CASE "major" = 0)                THEN BEGIN 
        SPRINT sphere_major "%sphere_major%, %sphere_gu%"  
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_gu_major.2da~
      END ELSE
      PATCH_IF ("%guardian%" STRING_COMPARE_CASE "minor" = 0)                THEN BEGIN 
        SPRINT sphere_minor "%sphere_minor%, %sphere_gu%"   
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_gu_minor.2da~
      END ELSE BEGIN SPRINT sphere_none "%sphere_none%, %sphere_gu%" END
      
      PATCH_IF (("%healing%" STRING_COMPARE_CASE "major" = 0) OR (cr_exception = 1)) THEN BEGIN 
        SPRINT sphere_major "%sphere_major%, %sphere_he%"  
        PATCH_IF ("%healing%" STRING_COMPARE_CASE "major" = 0) BEGIN APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_he_major.2da~ END
      END ELSE
      PATCH_IF ("%healing%" STRING_COMPARE_CASE "minor" = 0)                 THEN BEGIN 
        SPRINT sphere_minor "%sphere_minor%, %sphere_he%"   
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_he_minor.2da~
      END ELSE BEGIN SPRINT sphere_none "%sphere_none%, %sphere_he%" END
      
      PATCH_IF ("%law%" STRING_COMPARE_CASE "major" = 0)                     THEN BEGIN 
        SPRINT sphere_major "%sphere_major%, %sphere_lw%"  
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_lw_major.2da~
      END ELSE
      PATCH_IF ("%law%" STRING_COMPARE_CASE "minor" = 0)                     THEN BEGIN 
        SPRINT sphere_minor "%sphere_minor%, %sphere_lw%"   
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_lw_minor.2da~
      END ELSE BEGIN SPRINT sphere_none "%sphere_none%, %sphere_lw%" END
      
      PATCH_IF ("%necromantic%" STRING_COMPARE_CASE "major" = 0)             THEN BEGIN 
        SPRINT sphere_major "%sphere_major%, %sphere_ne%"  
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_ne_major.2da~
      END ELSE
      PATCH_IF ("%necromantic%" STRING_COMPARE_CASE "minor" = 0)             THEN BEGIN 
        SPRINT sphere_minor "%sphere_minor%, %sphere_ne%"   
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_ne_minor.2da~
      END ELSE BEGIN SPRINT sphere_none "%sphere_none%, %sphere_ne%" END
      
      PATCH_IF ("%necromantic_restorative%" STRING_COMPARE_CASE "major" = 0) THEN BEGIN 
        SPRINT sphere_major "%sphere_major%, %sphere_nr%"  
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_nr_major.2da~
      END ELSE
      PATCH_IF ("%necromantic_restorative%" STRING_COMPARE_CASE "minor" = 0) THEN BEGIN 
        SPRINT sphere_minor "%sphere_minor%, %sphere_nr%"   
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_nr_minor.2da~
      END ELSE BEGIN SPRINT sphere_none "%sphere_none%, %sphere_nr%" END
      
      PATCH_IF ("%numbers%" STRING_COMPARE_CASE "major" = 0)                 THEN BEGIN 
        SPRINT sphere_major "%sphere_major%, %sphere_nu%"  
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_nu_major.2da~
      END ELSE
      PATCH_IF ("%numbers%" STRING_COMPARE_CASE "minor" = 0)                 THEN BEGIN 
        SPRINT sphere_minor "%sphere_minor%, %sphere_nu%"   
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_nu_minor.2da~
      END ELSE BEGIN SPRINT sphere_none "%sphere_none%, %sphere_nu%" END
      
      PATCH_IF (("%plant%" STRING_COMPARE_CASE "major" = 0) OR (cr_exception = 1)) THEN BEGIN 
        SPRINT sphere_major "%sphere_major%, %sphere_pl%"  
        PATCH_IF ("%plant%" STRING_COMPARE_CASE "major" = 0) BEGIN APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_pl_major.2da~ END
      END ELSE
      PATCH_IF ("%plant%" STRING_COMPARE_CASE "minor" = 0)                   THEN BEGIN 
        SPRINT sphere_minor "%sphere_minor%, %sphere_pl%"   
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_pl_minor.2da~
      END ELSE BEGIN SPRINT sphere_none "%sphere_none%, %sphere_pl%" END
      
      PATCH_IF ("%protection%" STRING_COMPARE_CASE "major" = 0)              THEN BEGIN 
        SPRINT sphere_major "%sphere_major%, %sphere_pr%"  
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_pr_major.2da~
      END ELSE
      PATCH_IF ("%protection%" STRING_COMPARE_CASE "minor" = 0)              THEN BEGIN 
        SPRINT sphere_minor "%sphere_minor%, %sphere_pr%"   
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_pr_minor.2da~
      END ELSE BEGIN SPRINT sphere_none "%sphere_none%, %sphere_pr%" END
      
      PATCH_IF ("%summoning%" STRING_COMPARE_CASE "major" = 0)               THEN BEGIN 
        SPRINT sphere_major "%sphere_major%, %sphere_su%"  
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_su_major.2da~
      END ELSE
      PATCH_IF ("%summoning%" STRING_COMPARE_CASE "minor" = 0)               THEN BEGIN 
        SPRINT sphere_minor "%sphere_minor%, %sphere_su%"   
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_su_minor.2da~
      END ELSE BEGIN SPRINT sphere_none "%sphere_none%, %sphere_su%" END
      
      PATCH_IF ("%sun%" STRING_COMPARE_CASE "major" = 0)                     THEN BEGIN 
        SPRINT sphere_major "%sphere_major%, %sphere_sn%"  
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_sn_major.2da~
      END ELSE
      PATCH_IF ("%sun%" STRING_COMPARE_CASE "minor" = 0)                     THEN BEGIN 
        SPRINT sphere_minor "%sphere_minor%, %sphere_sn%"   
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_sn_minor.2da~
      END ELSE BEGIN SPRINT sphere_none "%sphere_none%, %sphere_sn%" END
      
      PATCH_IF ("%thoughts%" STRING_COMPARE_CASE "major" = 0)                THEN BEGIN 
        SPRINT sphere_major "%sphere_major%, %sphere_th%"  
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_th_major.2da~
      END ELSE
      PATCH_IF ("%thoughts%" STRING_COMPARE_CASE "minor" = 0)                THEN BEGIN 
        SPRINT sphere_minor "%sphere_minor%, %sphere_th%"   
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_th_minor.2da~
      END ELSE BEGIN SPRINT sphere_none "%sphere_none%, %sphere_th%" END
      
      PATCH_IF ("%time%" STRING_COMPARE_CASE "major" = 0)                    THEN BEGIN 
        SPRINT sphere_major "%sphere_major%, %sphere_ti%"  
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_ti_major.2da~
      END ELSE
      PATCH_IF ("%time%" STRING_COMPARE_CASE "minor" = 0)                    THEN BEGIN 
        SPRINT sphere_minor "%sphere_minor%, %sphere_ti%"   
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_ti_minor.2da~
      END ELSE BEGIN SPRINT sphere_none "%sphere_none%, %sphere_ti%" END
      
      PATCH_IF ("%travelers%" STRING_COMPARE_CASE "major" = 0)               THEN BEGIN 
        SPRINT sphere_major "%sphere_major%, %sphere_tr%"  
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_tr_major.2da~
      END ELSE
      PATCH_IF ("%travelers%" STRING_COMPARE_CASE "minor" = 0)               THEN BEGIN 
        SPRINT sphere_minor "%sphere_minor%, %sphere_tr%"   
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_tr_minor.2da~
      END ELSE BEGIN SPRINT sphere_none "%sphere_none%, %sphere_tr%" END
      
      PATCH_IF ("%war%" STRING_COMPARE_CASE "major" = 0)                     THEN BEGIN 
        SPRINT sphere_major "%sphere_major%, %sphere_wa%"  
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_wa_major.2da~
      END ELSE
      PATCH_IF ("%war%" STRING_COMPARE_CASE "minor" = 0)                     THEN BEGIN 
        SPRINT sphere_minor "%sphere_minor%, %sphere_wa%"   
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_wa_minor.2da~
      END ELSE BEGIN SPRINT sphere_none "%sphere_none%, %sphere_wa%" END
      
      PATCH_IF ("%wards%" STRING_COMPARE_CASE "major" = 0)                   THEN BEGIN 
        SPRINT sphere_major "%sphere_major%, %sphere_wd%"  
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_wd_major.2da~
      END ELSE
      PATCH_IF ("%wards%" STRING_COMPARE_CASE "minor" = 0)                   THEN BEGIN 
        SPRINT sphere_minor "%sphere_minor%, %sphere_wd%"   
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_wd_minor.2da~
      END ELSE BEGIN SPRINT sphere_none "%sphere_none%, %sphere_wd%" END
      
      PATCH_IF (("%weather%" STRING_COMPARE_CASE "major" = 0) OR (cr_exception = 1)) THEN BEGIN 
        SPRINT sphere_major "%sphere_major%, %sphere_we%"  
        PATCH_IF ("%weather%" STRING_COMPARE_CASE "major" = 0) BEGIN APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_we_major.2da~ END
      END ELSE
      PATCH_IF ("%weather%" STRING_COMPARE_CASE "minor" = 0)                 THEN BEGIN 
        SPRINT sphere_minor "%sphere_minor%, %sphere_we%"   
        APPEND_FILE ~weidu_external/divine_remix/spheres/%class%_wd_minor.2da~
      END ELSE BEGIN SPRINT sphere_none "%sphere_none%, %sphere_we%" END
      PATCH_IF cr_exception = 1 BEGIN APPEND_FILE ~weidu_external/divine_remix/spheres/cd_ranger_cleric.2da~ END
      
      ACTION_IF cd_adjust_table BEGIN 
        COPY ~weidu_external/divine_remix/spheres/temp.tpa~ ~weidu_external/divine_remix/spheres/allowed_%table%.tpa~
        COPY_EXISTING ~%table%.2da~ ~override~      
          APPEND_FILE ~weidu_external/divine_remix/spheres/allowed_%table%.tpa~
          LAUNCH_PATCH_MACRO ~reindex_clab~ // get ABLITYx in order
          PRETTY_PRINT_2DA
      END  
      
    // take care of descriptions
    ACTION_GET_STRREF string desc
    ACTION_IF (("%desc%" STRING_COMPARE_REGEXP ~<Invalid Strref -?[0-9]+>~) AND      // don't bother if no valid content in string
               ("%desc%" STRING_COMPARE_CASE ~%sphere_header%~) AND                  // strings should be unique, but in case sphere info already present, skip
               (("%sphere_major_orig%" STRING_COMPARE_CASE "%sphere_major%") OR 
                ("%sphere_minor_orig%" STRING_COMPARE_CASE "%sphere_minor%"))) BEGIN // at least *something^ added (aka the inquisitor exception)
    
      ACTION_IF ("%sphere_none_orig%" STRING_COMPARE_CASE "%sphere_none%" = 0) BEGIN                      // no 'none block'
        OUTER_SPRINT sphere ~%sphere_header%%LNL%%sphere_major%%LNL%%sphere_minor%~                       // assemble full block without none
      END ELSE BEGIN
        OUTER_SPRINT sphere ~%sphere_header%%LNL%%sphere_major%%LNL%%sphere_minor%%LNL%%sphere_none%~     // assemble full block with none
      END  
      OUTER_INNER_PATCH_SAVE sphere ~%sphere%~ BEGIN                                                      // and clean it up
        REPLACE_TEXTUALLY ~^%sphere_major_orig%$~ ~%sphere_major_none%~                                     // nothing was added to major, so sub alternate line
        REPLACE_TEXTUALLY ~^%sphere_minor_orig%$~ ~%sphere_minor_none%~                                     // nothing was added to minor, so sub alternate line
        REPLACE_TEXTUALLY ~%sphere_ne%, %sphere_nr%~ ~%sphere_ne%~                                        // collapse necromantic entries, if possible
        REPLACE_TEXTUALLY ~%sphere_ex%, %sphere_ea%, %sphere_ee%, %sphere_ef%, %sphere_ew%~ ~%sphere_ex%~ // collapse elemental entries, if possible
        REPLACE_TEXTUALLY ~CD_REPLACEME, ~ ~~                                                             // cleanup
      END  
    
      STRING_SET_EVALUATE string "%desc%%LNL%%LNL%%sphere%"
      
    END    
    
  END // table check  

END

/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////                                                  \\\\\
///// cd_hla_sphere_v9                                 \\\\\
/////                                                  \\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\

DEFINE_ACTION_FUNCTION cd_hla_sphere_v9
  STR_VAR
    source_table            = ""
    dest_table              = ""
    all                     = none
    animal                  = none
    astral                  = none
    chaos                   = none
    charm                   = none
    combat                  = none
    creation                = none
    divination              = none
    elemental               = none
    elemental_air           = none
    elemental_earth         = none
    elemental_fire          = none
    elemental_water         = none
    guardian                = none
    healing                 = none
    law                     = none
    necromantic             = none
    necromantic_restorative = none
    numbers                 = none
    plant                   = none
    protection              = none
    summoning               = none
    sun                     = none
    thoughts                = none
    time                    = none
    travelers               = none
    war                     = none
    wards                   = none
    weather                 = none
BEGIN

  ACTION_IF (("%source_table%" STRING_COMPARE_CASE "") AND ("%dest_table%" STRING_COMPARE_CASE "")) BEGIN  

    ACTION_PHP_EACH cd_spheres_hla_info AS pm => resref BEGIN
      OUTER_SET allowed = 0
      ACTION_FOR_EACH sphere IN ~%pm_1%~ ~%pm_2%~ ~%pm_3%~ BEGIN
        ACTION_IF !allowed BEGIN
          ACTION_IF (("%all%" STRING_COMPARE_CASE "major" = 0)                     AND ("%sphere%" STRING_COMPARE_CASE "al" = 0)) BEGIN OUTER_SET allowed = 1 END  
          ACTION_IF (("%animal%" STRING_COMPARE_CASE "major" = 0)                  AND ("%sphere%" STRING_COMPARE_CASE "an" = 0)) BEGIN OUTER_SET allowed = 1 END   
          ACTION_IF (("%astral%" STRING_COMPARE_CASE "major" = 0)                  AND ("%sphere%" STRING_COMPARE_CASE "as" = 0)) BEGIN OUTER_SET allowed = 1 END 
          ACTION_IF (("%chaos%" STRING_COMPARE_CASE "major" = 0)                   AND ("%sphere%" STRING_COMPARE_CASE "cs" = 0)) BEGIN OUTER_SET allowed = 1 END   
          ACTION_IF (("%charm%" STRING_COMPARE_CASE "major" = 0)                   AND ("%sphere%" STRING_COMPARE_CASE "cm" = 0)) BEGIN OUTER_SET allowed = 1 END 
          ACTION_IF (("%combat%" STRING_COMPARE_CASE "major" = 0)                  AND ("%sphere%" STRING_COMPARE_CASE "co" = 0)) BEGIN OUTER_SET allowed = 1 END 
          ACTION_IF (("%creation%" STRING_COMPARE_CASE "major" = 0)                AND ("%sphere%" STRING_COMPARE_CASE "cr" = 0)) BEGIN OUTER_SET allowed = 1 END 
          ACTION_IF (("%divination%" STRING_COMPARE_CASE "major" = 0)              AND ("%sphere%" STRING_COMPARE_CASE "di" = 0)) BEGIN OUTER_SET allowed = 1 END 
          ACTION_IF (("%elemental%" STRING_COMPARE_CASE "major" = 0)               AND ("%sphere%" STRING_COMPARE_CASE "ex" = 0)) BEGIN OUTER_SET allowed = 1 END 
          ACTION_IF (("%elemental_air%" STRING_COMPARE_CASE "major" = 0)           AND ("%sphere%" STRING_COMPARE_CASE "ea" = 0)) BEGIN OUTER_SET allowed = 1 END 
          ACTION_IF (("%elemental_earth%" STRING_COMPARE_CASE "major" = 0)         AND ("%sphere%" STRING_COMPARE_CASE "ee" = 0)) BEGIN OUTER_SET allowed = 1 END 
          ACTION_IF (("%elemental_fire%" STRING_COMPARE_CASE "major" = 0)          AND ("%sphere%" STRING_COMPARE_CASE "ef" = 0)) BEGIN OUTER_SET allowed = 1 END 
          ACTION_IF (("%elemental_water%" STRING_COMPARE_CASE "major" = 0)         AND ("%sphere%" STRING_COMPARE_CASE "ew" = 0)) BEGIN OUTER_SET allowed = 1 END 
          ACTION_IF (("%guardian%" STRING_COMPARE_CASE "major" = 0)                AND ("%sphere%" STRING_COMPARE_CASE "gy" = 0)) BEGIN OUTER_SET allowed = 1 END 
          ACTION_IF (("%healing%" STRING_COMPARE_CASE "major" = 0)                 AND ("%sphere%" STRING_COMPARE_CASE "he" = 0)) BEGIN OUTER_SET allowed = 1 END 
          ACTION_IF (("%law%" STRING_COMPARE_CASE "major" = 0)                     AND ("%sphere%" STRING_COMPARE_CASE "lw" = 0)) BEGIN OUTER_SET allowed = 1 END 
          ACTION_IF (("%necromantic%" STRING_COMPARE_CASE "major" = 0)             AND ("%sphere%" STRING_COMPARE_CASE "ne" = 0)) BEGIN OUTER_SET allowed = 1 END 
          ACTION_IF (("%necromantic_restorative%" STRING_COMPARE_CASE "major" = 0) AND ("%sphere%" STRING_COMPARE_CASE "nr" = 0)) BEGIN OUTER_SET allowed = 1 END 
          ACTION_IF (("%numbers%" STRING_COMPARE_CASE "major" = 0)                 AND ("%sphere%" STRING_COMPARE_CASE "nu" = 0)) BEGIN OUTER_SET allowed = 1 END 
          ACTION_IF (("%plant%" STRING_COMPARE_CASE "major" = 0)                   AND ("%sphere%" STRING_COMPARE_CASE "pl" = 0)) BEGIN OUTER_SET allowed = 1 END 
          ACTION_IF (("%protection%" STRING_COMPARE_CASE "major" = 0)              AND ("%sphere%" STRING_COMPARE_CASE "pr" = 0)) BEGIN OUTER_SET allowed = 1 END 
          ACTION_IF (("%summoning%" STRING_COMPARE_CASE "major" = 0)               AND ("%sphere%" STRING_COMPARE_CASE "su" = 0)) BEGIN OUTER_SET allowed = 1 END 
          ACTION_IF (("%sun%" STRING_COMPARE_CASE "major" = 0)                     AND ("%sphere%" STRING_COMPARE_CASE "sn" = 0)) BEGIN OUTER_SET allowed = 1 END 
          ACTION_IF (("%thoughts%" STRING_COMPARE_CASE "major" = 0)                AND ("%sphere%" STRING_COMPARE_CASE "th" = 0)) BEGIN OUTER_SET allowed = 1 END 
          ACTION_IF (("%time%" STRING_COMPARE_CASE "major" = 0)                    AND ("%sphere%" STRING_COMPARE_CASE "ti" = 0)) BEGIN OUTER_SET allowed = 1 END 
          ACTION_IF (("%travelers%" STRING_COMPARE_CASE "major" = 0)               AND ("%sphere%" STRING_COMPARE_CASE "tr" = 0)) BEGIN OUTER_SET allowed = 1 END 
          ACTION_IF (("%war%" STRING_COMPARE_CASE "major" = 0)                     AND ("%sphere%" STRING_COMPARE_CASE "wa" = 0)) BEGIN OUTER_SET allowed = 1 END 
          ACTION_IF (("%wards%" STRING_COMPARE_CASE "major" = 0)                   AND ("%sphere%" STRING_COMPARE_CASE "wd" = 0)) BEGIN OUTER_SET allowed = 1 END 
          ACTION_IF (("%weather%" STRING_COMPARE_CASE "major" = 0)                 AND ("%sphere%" STRING_COMPARE_CASE "we" = 0)) BEGIN OUTER_SET allowed = 1 END 
        END
      END
      ACTION_DEFINE_ASSOCIATIVE_ARRAY cd_spheres_hla_working BEGIN ~%pm_0%~, ~%pm_4%~, ~%pm_5%~, ~%pm_6%~, ~%pm_7%~, ~%pm_8%~, ~%pm_9%~ => ~%allowed%~ END
    END    
    
    COPY_EXISTING ~lu%source_table%.2da~ ~override/lu%dest_table%.2da~
      LAUNCH_PATCH_MACRO ~remove_blank_lines_from_eof~ // remove blank lines at end of file
      REPLACE_TEXTUALLY ~[%LNL%%MNL%%WNL%][0-9]+[ %TAB%]+\*[ %TAB%]+.+$~ ~~ // delete empty ability lines
      PATCH_PHP_EACH cd_spheres_hla_working AS pm => allowed BEGIN
        PATCH_IF !allowed BEGIN
          REPLACE_TEXTUALLY CASE_INSENSITIVE ~[%LNL%%MNL%%WNL%]+[0-9]+[ %TAB%]+GA_%pm_0%[ %TAB%]+.+~ ~~ // delete line
        END ELSE BEGIN
          REPLACE_EVALUATE ~\([ %TAB%]+GA_%pm_0%[ %TAB%]+\)~ BEGIN
            DEFINE_ASSOCIATIVE_ARRAY cd_spheres_hla_working BEGIN ~%pm_0%~, ~%pm_1%~, ~%pm_2%~, ~%pm_3%~, ~%pm_4%~, ~%pm_5%~, ~%pm_6%~ => 2 END
          END ~%MATCH1%~
        END
      END  

    ACTION_PHP_EACH cd_spheres_hla_working AS pm => allowed BEGIN
      ACTION_IF allowed = 1 BEGIN 
        APPEND ~lu%dest_table%.2da~ ~1 GA_%pm_0% * * %pm_1% %pm_2% %pm_3% %pm_4% %pm_5% %pm_6%~
      END
    END
    
    COPY_EXISTING ~lu%dest_table%.2da~ ~override~
      PATCH_IF FILE_EXISTS ~divine_remix/2da/hla_%dest_table%.2da~ BEGIN 
        APPEND_FILE ~divine_remix/2da/hla_%dest_table%.2da~
      END
      APPEND_FILE ~divine_remix/spheres/hla_padding.2da~
      COUNT_2DA_ROWS 10 rows
      FOR (index = 0 ; index < rows ; ++index) BEGIN
        PATCH_IF (index < 24) BEGIN
          SET_2DA_ENTRY index 0 10 (index + 1) // re-number rows
        END ELSE BEGIN
          SET_2DA_ENTRY index 0 10 DELETE_ROW
        END
      END
      REPLACE_TEXTUALLY ~[%LNL%%MNL%%WNL%]DELETE_ROW.+$~ ~~ // delete lines past 24
      PRETTY_PRINT_2DA

  END

END
