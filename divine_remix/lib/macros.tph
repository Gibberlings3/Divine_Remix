        PATCH_IF ("%weather%" STRING_COMPARE_CASE "major" = 0)                 THEN BEGIN APPEND_FILE ~divine_remix/spheres/%class%_we_major.2da~ APPEND_FILE ~divine_remix/spheres/hla_we.2da~ END
