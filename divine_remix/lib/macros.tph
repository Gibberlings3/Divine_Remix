/////                                                  \\\\\
///// reindex_clab                                     \\\\\
/////                                                  \\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\

DEFINE_PATCH_MACRO ~reindex_clab~ BEGIN
  SET "ability" = 0
  REPLACE_EVALUATE ~^\(newline\)\|\(ABILITY[0-9A-Z]+\)[ %TAB%]~ BEGIN
    SET "ability" = ("%ability%" + 1)
  END
  ~ABILITY%ability% ~
END

/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////                                                  \\\\\
///// remove_blank_lines_from_eof                      \\\\\
/////                                                  \\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\

DEFINE_PATCH_MACRO ~remove_blank_lines_from_eof~ BEGIN
  SET "size" = (SOURCE_SIZE - 1)
  READ_BYTE ("%size%") "eof"
  WHILE ((%size% > 0) AND (("%eof%" = 0x0a) OR ("%eof%" = 0x0d))) BEGIN // removes any empty lines at the end of the file
    DELETE_BYTES "%size%" 0x01
    SET "size" = ("%size%" - 1)
    READ_BYTE ("%size%") "eof"
  END
END

/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////                                                  \\\\\
///// extend_clab_to_level_50                          \\\\\
/////                                                  \\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\

DEFINE_PATCH_MACRO ~extend_clab_to_level_50~ BEGIN

  REPLACE_TEXTUALLY ~[%WNL%%MNL%]+~ ~%LNL%~
  REPLACE_TEXTUALLY ~\(1[ %TAB%]+2[ %TAB%]+3[ %TAB%]+4[ %TAB%]+5[ %TAB%]+6[ %TAB%]+7[ %TAB%]+8[ %TAB%]+9[ %TAB%]+10[ %TAB%]+11[ %TAB%]+12[ %TAB%]+13[ %TAB%]+14[ %TAB%]+15[ %TAB%]+16[ %TAB%]+17[ %TAB%]+18[ %TAB%]+19[ %TAB%]+20[ %TAB%]+21[ %TAB%]+22[ %TAB%]+23[ %TAB%]+24[ %TAB%]+25[ %TAB%]+26[ %TAB%]+27[ %TAB%]+28[ %TAB%]+29[ %TAB%]+30[ %TAB%]+31[ %TAB%]+32[ %TAB%]+33[ %TAB%]+34[ %TAB%]+35[ %TAB%]+36[ %TAB%]+37[ %TAB%]+38[ %TAB%]+39\)\([ %TAB%]+\)40[ %TAB%]*~
    ~\1\240\241\242\243\244\245\246\247\248\249\250~
  REPLACE_TEXTUALLY ~^\(ABILITY[0-9A-Z]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+\)\([ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%]+[ %TAB%]+[^ %TAB%%lnl%]+\)[ %TAB%]*$~
    ~\1\2\2~ 
END

/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////                                                  \\\\\
///// mod kit remover                                  \\\\\
/////                                                  \\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\

DEFINE_ACTION_FUNCTION cd_mkr
  INT_VAR remove_orig = 0
  STR_VAR class = "c"
  BEGIN

  ACTION_IF remove_orig = 1 THEN BEGIN

    OUTER_SET last_kit = 0
  
  END ELSE BEGIN

    COPY_EXISTING ~kitlist.2da~ ~override~ // look for kit descripts
      COUNT_2DA_ROWS 9 rows
      SET last_kit = 0
      FOR (index = 2 ; index < rows ; ++index) BEGIN
        READ_2DA_ENTRY index 1 8 name
        PATCH_IF (("%name%" STRING_COMPARE_CASE "OHTYR" = 0) OR // bg2ee
                  ("%name%" STRING_COMPARE_CASE "SUN_SOUL" = 0) OR // bgee
                  ("%name%" STRING_COMPARE_CASE "OHTEMPUS" = 0) OR // iwdee
                  ("%name%" STRING_COMPARE_CASE "BARBARIAN" = 0)) BEGIN // bg2/bgt/tutu
          READ_2DA_ENTRY index 0 8 last_kit
        END
      END
      BUT_ONLY

  END

  ACTION_FOR_EACH race IN d e g h he hl ho BEGIN
  
    ACTION_IF FILE_EXISTS_IN_GAME ~k_%class%_%race%.2da~ THEN BEGIN
  
      COPY_EXISTING ~k_%class%_%race%.2da~ ~override~
        REPLACE_EVALUATE ~\([%LNL%%MNL%%WNL%]*[0-9]+[ %TAB%]+\)\([0-9]+\)~ BEGIN
          PATCH_IF (MATCH2 > last_kit) BEGIN
            SPRINT replace ""
          END ELSE BEGIN
            SPRINT replace "%MATCH1%%MATCH2%"
          END
        END
        ~%replace%~
        BUT_ONLY

    END

  END

END

/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////                                                  \\\\\
///// cd_assign_kit_to_cre                             \\\\\
/////                                                  \\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\

DEFINE_PATCH_FUNCTION cd_assign_kit_to_cre 
  INT_VAR name = 1
BEGIN

  READ_LONG 0x244 curr_kit
  PATCH_IF curr_kit = 0x40000000 OR curr_kit = 0 BEGIN
    WRITE_LONG  0x244 0
    WRITE_SHORT 0x246 kit
    PATCH_IF name BEGIN 
      PATCH_FOR_EACH off IN 0x08 0x0c BEGIN 
        READ_STRREF off name
        PATCH_IF ("%name%" STRING_COMPARE_REGEXP ~<Invalid Strref -?[0-9]+>~) BEGIN // checking for valid content in string
          INNER_PATCH_SAVE name ~%name%~ BEGIN
            REPLACE_TEXTUALLY ~%name_cleric%~ ~%kitname%~ // from 'cleric' to 'Morninglord'
            REPLACE_TEXTUALLY ~%name_priest%~ ~%kitname%~ // from 'priest/priestess' to 'Morninglord'
          END
          SAY_EVALUATED off ~%name%~ // write changes
        END
      END 
    END
  END    
  
END

/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////                                                  \\\\\
///// cd_create_holy_symbol                            \\\\\
/////                                                  \\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\

DEFINE_ACTION_FUNCTION cd_create_holy_symbol
  INT_VAR 
    name    = "-1"
    desc    = "-1"
    kit     = "-1"
    kit319s = "-1"
    kitbits = "-1"
  STR_VAR
    symbol = ""
    iicon  = ""
    cicon  = ""
BEGIN

  OUTER_FOR (index = 1 ; index < 7 ; ++index) BEGIN

    EXTEND_TOP ~baldur.bcs~   ~divine_remix/baf/holysym.baf~ EVALUATE_BUFFER
    EXTEND_TOP ~baldur25.bcs~ ~divine_remix/baf/holysym.baf~ EVALUATE_BUFFER

  END
  
  COPY ~divine_remix/itm/generic_holy_symbol.itm~ ~override/%symbol%.itm~
    WRITE_LONG 0x08 name
    WRITE_LONG 0x0c name
    WRITE_LONG 0x50 desc
    WRITE_LONG 0x54 desc
    WRITE_ASCIIE 0x3a "%iicon%" #8
    WRITE_ASCIIE 0x58 "%cicon%" #8
    PATCH_IF enhanced_edition BEGIN
      LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 319 target = 1 power = 1 parameter1 = (0x4000 + kit) parameter2 = 9 timing = 2 special = kit319s END
    END ELSE BEGIN     
      WRITE_LONG 0x1e (kitbits + BIT6 + BIT11 + BIT12 + BIT13 + BIT16 + BIT17 + BIT18 + BIT19 + BIT20 + BIT21 + BIT22 + BIT29 + BIT30)
    END  
    
END

/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////                                                  \\\\\
///// cd_aoe_compat                                    \\\\\
/////                                                  \\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\
/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\/////\\\\\

ACTION_IF FILE_EXISTS_IN_GAME ~j#aoev22.txt~ THEN BEGIN // if Ashes of Embers is installed

  DEFINE_ACTION_FUNCTION cd_aoe_compat
    INT_VAR column = "-1"
            pips   = 1
  BEGIN

    COPY_EXISTING ~weapprof.2da~ ~override~
      FOR (row = 2; row < (45 - (10 * pips)) ; row = row + 1) BEGIN // go to row 35 if pips = 1, 25 if pips = 2
        SET_2DA_ENTRY_LATER ~aoe~ row column ~%pips%~
      END
      PATCH_IF pips = 2 BEGIN
        SET_2DA_ENTRY_LATER ~aoe~ 4 column ~0~
        SET_2DA_ENTRY_LATER ~aoe~ 9 column ~0~
      END
      SET_2DA_ENTRIES_NOW ~aoe~ 1
      BUT_ONLY

  END

END ELSE BEGIN // if aoe is not installed, make this a blank function

  DEFINE_ACTION_FUNCTION cd_aoe_compat BEGIN END
  
END

