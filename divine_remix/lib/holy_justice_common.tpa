// change spells to innates as needed
LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = sppr208 destination = cdtyr1  RET_ARRAY cd_clone_spell_array END // hold person
LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = spwi408 destination = cdtyr7  RET_ARRAY cd_clone_spell_array END // stoneskin
LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = spwi708 destination = cdtyr14 RET_ARRAY cd_clone_spell_array END // mantle

OUTER_SPRINT hw_name @13311 // Warhammer - 'Hammer of Justice'
