// this file is provided as an example of how to add your spells and kits to divine remix's sphere system

/////                                                  \\\\\
///// checking for DR's spheres                        \\\\\
/////                                                  \\\\\

ACTION_IF ((MOD_IS_INSTALLED ~divine_remix.tp2~ ~1000~) AND              // check if the spheres system is installed 
           (FILE_EXISTS ~divine_remix/lib/modder_tools.tpa~)) BEGIN // this library from v9+ is present (previous versions won't have this file)
       
  INCLUDE ~divine_remix/lib/modder_tools.tpa~ // this file contains all of the functions and code you'll need

  /////                                                  \\\\\
  ///// adding spells to the spheres                     \\\\\
  /////                                                  \\\\\

  // let's say we've added some very simple spells: cleric versions of grease and chain lightning. 

  // this array is what DR uses to process spells into spheres
  // since other mods may be using this too, blank it first
  ACTION_CLEAR_ARRAY cd_add_spells_to_dr_spheres 
  
  // now we create an array of spells we've just added. Use the symbolic name and then specify up to 
  // three spheres for each new spell. You can also leave them blank. The two-letter abbreviations can 
  // be found in divine_remix/lib/spheres_definitions.tpa
  ACTION_DEFINE_ASSOCIATIVE_ARRAY cd_add_spells_to_dr_spheres BEGIN
    CLERIC_GREASE,          ~al~, ~~,   ~~ => 0 // adding grease as an 'All' sphere spell, no other spheres
    CLERIC_CHAIN_LIGHTNING, ~we~, ~ea~, ~~ => 0 // adding chain lightning as a 'weather' and 'elemental air' sphere spell
  END

  // now just invoke a macro from the include to do the rest:
  LAM cd_add_spells_to_dr_spheres

  /////                                                  \\\\\
  ///// applying spheres to your kits                    \\\\\
  /////                                                  \\\\\
  
  // applying sphere restrictions is super easy as it's just a function
  LAUNCH_ACTION_FUNCTION cd_kit_sphere_v9
    INT_VAR 
      string                  = 0 // set this to the 'help' (description) of your kit; sphere information will be added automatically. 
      cr_exception            = 0 // if it's a cleric-ranger kit, set this to 1 to get basic ranger spheres in addition to the specifications below
    STR_VAR
      table                   = clabpr01 // your kit's ability table. spells are added by applying a series of spells via the ability table. 
      class                   = cleric   // allowed values are cleric, druid, ranger, paladin - this basically sets the levels at which spells appear
      all                     = none     // allowed values are major or minor; all other entries are treated as 'none'
      animal                  = none     // major access allows all spells in a sphere
      astral                  = none     // minor access allows spells up to spell level 3
      chaos                   = none
      charm                   = none
      combat                  = none
      creation                = none
      divination              = none
      elemental               = none     // if the kit has access to the entire elemental sphere, make sure you
      elemental_air           = none     // also allow the same access to the air/earth/fire/water sub-spheres
      elemental_earth         = none
      elemental_fire          = none
      elemental_water         = none
      guardian                = none
      healing                 = none
      law                     = none
      necromantic             = none     // some deities only only access to beneficial necromantic spells, so necromantic
      necromantic_restorative = none     // gets split so you can make the distinction if needed. Like elemental, specify 
      numbers                 = none     // the same access to _restorative as necromantic if they should have full access
      plant                   = none
      protection              = none
      summoning               = none
      sun                     = none
      thoughts                = none
      time                    = none
      travelers               = none
      war                     = none
      wards                   = none
      weather                 = none
  END
  
  // for working examples, DR uses this function internally for its kits. check out any of the kit_foo.tpa files in 
  // divine_remix/spheres. Since they're invoked from an array they use some variables, e.g. strref and params_1.  

  /////                                                  \\\\\
  ///// closing out                                      \\\\\
  /////                                                  \\\\\

END // just the last bit to close the MOD_IS_INSTALLED check
  