// this file is provided as an example of how to add your spells to divine remix's spheres

// first we're going to simulate a *very* small mod that adds Grease and Chain Lightning as divine spell:
COPY_EXISTING ~spwi101.spl~ ~override~
ADD_SPELL ~override/spwi101.spl~ 1 1 CLERIC_GREASE
COPY_EXISTING ~spwi615.spl~ ~override~
ADD_SPELL ~override/spwi615.spl~ 1 6 CLERIC_CHAIN_LIGHTNING

// and now for the dr compatibility stuff:

ACTION_IF ((MOD_IS_INSTALLED ~divine_remix.tp2~ ~1000~) AND              // check if the spheres system is installed 
           (FILE_EXISTS ~divine_remix/lib/modder_add_spells.tpa~)) BEGIN // this library from v9+ is present (previous versions won't have this file)

  // this array is what DR uses to process spells into spheres
  // since other mods may be using this too, blank it first
  ACTION_CLEAR_ARRAY cd_add_spells_to_dr_spheres 
  
  // now we create an array of spells we've just added. Use the symbol and then specify up to three spheres 
  // for each new spell. You can also leave them blank. The two-letter abbreviations can be found in
  // divine_remix/lib/spheres_definitions.tpa
  ACTION_DEFINE_ASSOCIATIVE_ARRAY cd_add_spells_to_dr_spheres BEGIN
    CLERIC_GREASE,          ~al~, ~~,   ~~ => 0 // adding grease as an 'All' sphere spell, no other spheres
    CLERIC_CHAIN_LIGHTNING, ~we~, ~ea~, ~~ => 0 // adding chain lightning as a 'weather' and 'elemental air' sphere spell
  END

  // now include this file and it will do the rest
  INCLUDE ~divine_remix/lib/modder_add_spells.tpa~

END  
  
  