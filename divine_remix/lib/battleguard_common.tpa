ACTION_IF game_includes_tob THEN BEGIN

  COPY ~Divine_Remix/spl/a#tem71.spl~ ~override~  // Tempus' Shield
    SAY NAME1 @10912
    SAY NAME2 @10912
    SAY UNIDENTIFIED_DESC @10913
	SAY DESC @10913

END

OUTER_SPRINT hw_name @10903
OUTER_SPRINT hw_desc @10904
LAF cd_dr_holy_weapon STR_VAR item = ~a#tem0~ name = EVAL ~%hw_name%~ desc = EVAL ~%hw_desc%~ END

// change spells to innates as needed
LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = sppr412 destination = ~a#tem07~ RET_ARRAY cd_clone_spell_array END // holy power
LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = spwi508 destination = ~a#tem09~ RET_ARRAY cd_clone_spell_array END // chaos
LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = spwi603 destination = ~a#tem11~ RET_ARRAY cd_clone_spell_array END // tenser's transformation
LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = spwi711 destination = ~a#tem14~ RET_ARRAY cd_clone_spell_array END // sphere of chaos
