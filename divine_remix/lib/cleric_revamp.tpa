/////                                                  \\\\\
///// innates for bioware three                        \\\\\
/////                                                  \\\\\

COPY ~divine_remix/2da/clabpr02.2da~ ~override~ // new ability tables
     ~divine_remix/2da/clabpr03.2da~ ~override~
     ~divine_remix/2da/clabpr04.2da~ ~override~  
  PATCH_IF !game_includes_tob THEN BEGIN
    REPLACE_TEXTUALLY ~AP_CDHLYSYM~ ~****       ~
  END

     
/////                                                  \\\\\
///// innates                                          \\\\\
/////                                                  \\\\\

// change spells to innates as needed
ACTION_CLEAR_ARRAY cd_clone_spell_array // do this once
LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = spwi324 destination = cdlthun RET_ARRAY cd_clone_spell_array END // hold undead innate
LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = sppr503 destination = cdltflm RET_ARRAY cd_clone_spell_array END // flame strike innate
LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = sppr607 destination = cdlthel RET_ARRAY cd_clone_spell_array END // heal innate
LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = sppr713 destination = cdltgrs RET_ARRAY cd_clone_spell_array END // greater restoration innate
LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = sppr304 destination = cdhmglp RET_ARRAY cd_clone_spell_array END // glyph of warding innate
LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = sppr415 destination = cdhmfst RET_ARRAY cd_clone_spell_array END // farsight innate
LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = spwi511 destination = cdhmpnw RET_ARRAY cd_clone_spell_array END // protection from normal weapons innate
LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = sppr505 destination = cdhmtse RET_ARRAY cd_clone_spell_array END // true seeing innate
LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = spwi708 destination = cdhmmnt RET_ARRAY cd_clone_spell_array END // mantle innate
LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = spwi502 destination = cdtlcld RET_ARRAY cd_clone_spell_array END // cloudkill innate
LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = spwi615 destination = cdtlcnl RET_ARRAY cd_clone_spell_array END // chain lightning innate
LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = sppr720 destination = cdtlqak RET_ARRAY cd_clone_spell_array END // earthquake innate

COPY ~Divine_Remix/spl/cdtlers.spl~ ~override~ // electrical resistance
  SAY NAME1 @10166
  SAY NAME2 @10166
  SAY UNIDENTIFIED_DESC @10166
  SAY DESC @10166

COPY ~Divine_Remix/spl/cdtldst.spl~ ~override~ // destructive blow
  SAY NAME1 @10169
  SAY NAME2 @10169
  SAY UNIDENTIFIED_DESC @10170
  SAY DESC @10170
  LPF CD_EXTEND-O-MATIC INT_VAR base_dur = 0 step_dur = 6 level_cap = dr_level_cap END // 1 round/level
     
/////                                                  \\\\\
///// holy weapons                                     \\\\\
/////                                                  \\\\\

COPY ~divine_remix/bam/cdilath.bam~  ~override~
     ~divine_remix/bam/cdihelm.bam~  ~override~
     ~divine_remix/bam/cditalos.bam~ ~override~

OUTER_SPRINT hw_name @10180
OUTER_SPRINT hw_desc @10181
LAF cd_dr_holy_weapon STR_VAR item = cdltmc name = EVAL ~%hw_name%~ desc = EVAL ~%hw_desc%~ END

OUTER_SPRINT hw_name @10185
OUTER_SPRINT hw_desc @10186
LAF cd_dr_holy_weapon STR_VAR item = cdhmbs name = EVAL ~%hw_name%~ desc = EVAL ~%hw_desc%~ END

OUTER_SPRINT hw_name @10167
OUTER_SPRINT hw_desc @10168
LAF cd_dr_holy_weapon STR_VAR item = cdtlsp name = EVAL ~%hw_name%~ desc = EVAL ~%hw_desc%~ END
     
/////                                                  \\\\\
///// tempus check                                     \\\\\
/////                                                  \\\\\

ACTION_IF FILE_EXISTS_IN_GAME ~ohtempus.2da~ THEN BEGIN // do tempus as part of the main component on the EEs

  LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = sppr412 destination = ~a#tem07~ RET_ARRAY cd_clone_spell_array END // holy power
  COPY ~divine_remix/2da/a#temp.2da~ ~override/ohtempus.2da~
    PATCH_IF !game_includes_tob THEN BEGIN
      REPLACE_TEXTUALLY ~AP_CDHLYSYM~ ~****       ~
    END
  INCLUDE ~divine_remix/lib/battleguard_common.tpa~
  
END
     
/////                                                  \\\\\
///// tyr check                                        \\\\\
/////                                                  \\\\\

ACTION_IF FILE_EXISTS_IN_GAME ~ohtyr.2da~ THEN BEGIN // do tyr as part of the main component on the EEs

  COPY ~divine_remix/2da/cdtyr.2da~ ~override/ohtyr.2da~
    REPLACE_TEXTUALLY ~cdtyr9~  ~ohtyr1~
    REPLACE_TEXTUALLY ~cdtyr11~ ~ohtyr2~
    PATCH_IF !game_includes_tob THEN BEGIN
      REPLACE_TEXTUALLY ~AP_CDHLYSYM~ ~****       ~
    END
  INCLUDE ~divine_remix/lib/holy_justice_common.tpa~
  
END

PRINT @3
INCLUDE ~divine_remix/lib/cd_clone_spell_bulk_last.tpa~