  PATCH_PHP_EACH cd_use_class8 AS item => foo BEGIN
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 180 target = 1 parameter1 = disallow  timing = 1 STR_VAR resource = EVAL ~%item%~ END
  END

