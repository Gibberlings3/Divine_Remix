
/*
DONE:
red knight - any weapon
correllon - any weapon
cyric can use longswords
tyr - long, bastard swords
sune - darts
xvim - nonmissile bludgeoning and javelins
ilmater - no armor
shar - up to chain
kossuth - up to chain
oghma - up to banded (splint?), no shields

NOT DONE:
talos javelins - no javelins in game
tempus one choice outside of cleric - not really feasible
*/

COPY_EXISTING ~kitlist.2da~ ~override~ // look for kit descripts
  COUNT_2DA_ROWS 9 rows
  FOR (index = 0 ; index < rows ; ++index) BEGIN
    READ_2DA_ENTRY index 8 9 class
    PATCH_IF ((IS_AN_INT class) AND ((class = 3) OR (class = 8) OR (class = 14) OR (class = 15) OR (class = 17) OR (class = 18))) BEGIN
      READ_2DA_ENTRY index 5 9 clab
      SET $classkit("%clab%") = 0
      PATCH_FOR_EACH table IN ~a#cyric~ ohtyr cdtyr ~a#shar~ ~a#red~ cdilmatr ~a#koss~ cdxvim ~a#ogma~ nmsune ~a#feyw~ BEGIN
        PATCH_IF ("%clab%" STRING_COMPARE_CASE "%table%" = 0) BEGIN
          READ_2DA_ENTRY index 4 9 desc
          READ_2DA_ENTRY index 3 9 name
          READ_2DA_ENTRY index 0 9 kit
          SET kit += 0x4000
          SET $kitid("%table%")   = kit
          SET $kitname("%table%") = name
          SET $kitdesc("%table%") = desc
        END
      END
    END
  END
  BUT_ONLY

COPY_EXISTING_REGEXP GLOB ~^.+\.itm$~ ~override~
  READ_LONG 0x18 flags
  PATCH_IF ((flags & BIT2) != 0) BEGIN // don't bother if not droppable
    SET cleric       = 1
    SET plate        = 0
    SET splint       = 0
    SET weapon_gen   = 0
    SET longsword    = 0
    SET killedkenny  = 0
    SET darts        = 0
    READ_LONG  0x1e use
    READ_SHORT 0x1c type
    READ_ASCII 0x22 anim (2)
    READ_BYTE  0x31 prof
    PATCH_IF ((use & BIT7) != 0) BEGIN SET cleric = 0 END
    PATCH_IF type = 2 BEGIN // armor
      PATCH_IF VARIABLE_IS_SET $kitid("cdilmatr") AND cleric BEGIN
        LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 319 target = 1 parameter1 = $kitid("cdilmatr") parameter2 = 9 timing = 2 special = $kitname("cdilmatr") END
      END
      PATCH_IF ("%anim%" STRING_COMPARE_CASE "3a" = 0) BEGIN // chain or splint
        PATCH_IF ((use & BIT6) != 0) BEGIN // unusable by bards
          SET splint = 1
        END ELSE BEGIN
          SET chain = 1
        END
      END ELSE
      PATCH_IF ("%anim%" STRING_COMPARE_CASE "4a" = 0) BEGIN // plate
        SET plate = 1
      END
    END ELSE
    PATCH_IF type = 12  BEGIN // shields
      PATCH_IF VARIABLE_IS_SET $kitid("a#ogma") AND cleric BEGIN
        LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 319 target = 1 parameter1 = $kitid("a#ogma") parameter2 = 9 timing = 2 special = $kitname("a#ogma") END
      END
      SET shield = 1
    END ELSE
    PATCH_IF ((type = 5) OR ((type >= 14) AND (type <= 31)) OR (type = 51))  BEGIN // weapons
      READ_BYTE  0x31 prof
      SET weapon_gen = 1
      PATCH_IF ((type = 18) OR (type = 14)) BEGIN
        PATCH_IF VARIABLE_IS_SET $kitid("cdxvim") AND cleric BEGIN
          LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 319 target = 1 parameter1 = $kitid("cdxvim") parameter2 = 9 timing = 2 special = $kitname("cdxvim") END
        END
      END // slings, bullets
      PATCH_IF type = 24 BEGIN SET darts = 1 END
      PATCH_IF type = 20 BEGIN // "large" swords
        PATCH_IF prof = 90 BEGIN SET longsword = 1 END ELSE // long sword
        PATCH_IF prof = 89 BEGIN SET killedkenny = 1 END    // bastard sword
      END
    END
    PATCH_IF (plate OR splint OR weapon_gen OR longsword OR killedkenny OR darts) BEGIN // interesting check
      DEFINE_ASSOCIATIVE_ARRAY cd_cleric_usability BEGIN
        ~%SOURCE_RES%~, ~%cleric%~,~%plate%~,~%splint%~,~%weapon_gen%~,~%longsword%~,~%killedkenny%~,~%darts%~ => ~%SOURCE_RES%~
      END
    END
  END //
  BUT_ONLY

ACTION_PHP_EACH cd_cleric_usability AS pm => item BEGIN

  //PRINT ~  %pm_0%, %pm_1%, %pm_2%, %pm_3%, %pm_4%, %pm_5%, %pm_6%, %pm_7% => %item%~

  ACTION_IF ((pm_1 AND pm_2) AND // plate that's usable by clerics
            ((VARIABLE_IS_SET $kitid("a#koss")) OR
             (VARIABLE_IS_SET $kitid("a#shar")) OR
             (VARIABLE_IS_SET $kitid("a#ogma")))) BEGIN

    COPY_EXISTING ~%item%.itm~ ~override~
      PATCH_IF VARIABLE_IS_SET $kitid("a#koss") BEGIN
        LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 319 target = 1 parameter1 = $kitid("a#koss") parameter2 = 9 timing = 2 special = $kitname("a#koss") END
      END
      PATCH_IF VARIABLE_IS_SET $kitid("a#shar") BEGIN
        LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 319 target = 1 parameter1 = $kitid("a#shar") parameter2 = 9 timing = 2 special = $kitname("a#shar") END
      END
      PATCH_IF VARIABLE_IS_SET $kitid("a#ogma") BEGIN
        LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 319 target = 1 parameter1 = $kitid("a#ogma") parameter2 = 9 timing = 2 special = $kitname("a#ogma") END
      END
      BUT_ONLY

  END

  ACTION_IF ((pm_1 AND pm_3) AND // splint that's usable by clerics
            ((VARIABLE_IS_SET $kitid("a#koss")) OR
             (VARIABLE_IS_SET $kitid("a#shar")))) BEGIN

    COPY_EXISTING ~%item%.itm~ ~override~
      PATCH_IF VARIABLE_IS_SET $kitid("a#koss") BEGIN
        LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 319 target = 1 parameter1 = $kitid("a#koss") parameter2 = 9 timing = 2 special = $kitname("a#koss") END
      END
      PATCH_IF VARIABLE_IS_SET $kitid("a#shar") BEGIN
        LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 319 target = 1 parameter1 = $kitid("a#shar") parameter2 = 9 timing = 2 special = $kitname("a#shar") END
      END
      BUT_ONLY

  END

  ACTION_IF (!pm_1 AND pm_4) BEGIN // general weapon that isn't usable by clerics

    COPY_EXISTING ~%item%.itm~ ~override~
      PATCH_IF ((use & BIT21) = 0) BEGIN // if usable by rangers
        SET $cd_use_class3("%SOURCE_RES%") = 0
        // how all of these checks work: if the kit is installed (var is set), check if the kit should have access. If no, add to kit-specific list
        PATCH_IF !pm_7             BEGIN SET $cd_use_kit1("%SOURCE_RES%") = 0 END // darts for sune
        PATCH_IF !pm_5             BEGIN SET $cd_use_kit2("%SOURCE_RES%") = 0 END // longswords for cyric
        PATCH_IF (!pm_5 AND !pm_6) BEGIN SET $cd_use_kit3("%SOURCE_RES%") = 0 END // long, bastard swords for tyr
        READ_LONG  0x1e use
        SET use = (use BAND `BIT7)                                              // remove cleric bit
        LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 319 target = 1 parameter1 = 22 parameter2 = 5 timing = 2 special = 1079 END
        PATCH_IF (((use & BIT18) = 0) AND ((use & BIT8)  != 0)) BEGIN
          SET use = (use BAND `BIT8)  SET $cd_use_class14("%SOURCE_RES%") = 0   // usable by mages, remove m/c restriction
          LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 319 target = 1 parameter1 = 22 parameter2 = 5 timing = 2 special = 1058 END
        END
        PATCH_IF (((use & BIT22) = 0) AND ((use & BIT9)  != 0)) BEGIN
          SET use = (use BAND `BIT9)  SET $cd_use_class15("%SOURCE_RES%") = 0   // usable by thieves, remove c/t restriction
          LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 319 target = 1 parameter1 = 22 parameter2 = 5 timing = 2 special = 1065 END
        END
        PATCH_IF (((use & BIT21) = 0) AND ((use & BIT10) != 0)) BEGIN
          SET use = (use BAND `BIT10) SET $cd_use_class18("%SOURCE_RES%") = 0   // usable by rangers, remove c/r restriction
          LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 319 target = 1 parameter1 = 22 parameter2 = 5 timing = 2 special = 1073 END
        END
        PATCH_IF (((use & BIT11) = 0) AND ((use & BIT14) != 0)) BEGIN
          SET use = (use BAND `BIT14) SET $cd_use_class8("%SOURCE_RES%") = 0    // usable by fighters, remove f/c restriction
          LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 319 target = 1 parameter1 = 22 parameter2 = 5 timing = 2 special = 1053 END
          PATCH_IF (((use & BIT18) = 0) AND ((use & BIT15) != 0)) BEGIN
            SET use = (use BAND `BIT15) SET $cd_use_class17("%SOURCE_RES%") = 0 // if also usable by mages, remove f/m/c restriction
            LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 319 target = 1 parameter1 = 22 parameter2 = 5 timing = 2 special = 1075 END
          END
        END
        WRITE_LONG 0x1e use
      END
      BUT_ONLY

  END

END

OUTER_SET disallow = RESOLVE_STR_REF(@300001)
COPY ~divine_remix/spheres/template.spl~ ~override/cdusec3.spl~
  PATCH_PHP_EACH cd_use_class3 AS item => foo BEGIN
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 180 target = 1 parameter1 = disallow  timing = 1 STR_VAR resource = EVAL ~%item%~ END
  END

