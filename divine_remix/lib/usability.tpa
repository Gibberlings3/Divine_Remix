  PATCH_PHP_EACH cd_use_class18 AS item => foo BEGIN
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 180 target = 1 parameter1 = disallow  timing = 1 STR_VAR resource = EVAL ~%item%~ END
  END

ACTION_FOR_EACH class IN /*3*/ 8 14 15 17 18 BEGIN

  COPY_EXISTING ~cdusec%class%.spl~  ~override~
    //LPF ADD_SPELL_EFFECT INT_VAR insert_point = 0 opcode = 318 target = 1 timing = 1 parameter1 = class parameter2 = 115 STR_VAR resource = EVAL ~%SOURCE_RES%~ END
    LPF ADD_SPELL_EFFECT INT_VAR insert_point = 0 opcode = 321 target = 1 timing = 1 STR_VAR resource = cdusec3 END // for dual-classes

END

COPY ~divine_remix/spheres/template.spl~ ~override/cdusek0.spl~
COPY ~divine_remix/spheres/template.spl~ ~override/cdusek1.spl~
  PATCH_PHP_EACH cd_use_kit1 AS item => foo BEGIN
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 180 target = 1 parameter1 = disallow  timing = 1 STR_VAR resource = EVAL ~%item%~ END
  END

COPY ~divine_remix/spheres/template.spl~ ~override/cdusek2.spl~
  PATCH_PHP_EACH cd_use_kit2 AS item => foo BEGIN
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 180 target = 1 parameter1 = disallow  timing = 1 STR_VAR resource = EVAL ~%item%~ END
  END

COPY ~divine_remix/spheres/template.spl~ ~override/cdusek3.spl~
  PATCH_PHP_EACH cd_use_kit3 AS item => foo BEGIN
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 180 target = 1 parameter1 = disallow  timing = 1 STR_VAR resource = EVAL ~%item%~ END
  END

COPY_EXISTING ~cdusek0.spl~ ~override~
              ~cdusek1.spl~ ~override~
              ~cdusek2.spl~ ~override~
              ~cdusek3.spl~ ~override~
  PATCH_FOR_EACH class IN 0 3 8 14 15 17 18 BEGIN
    LPF ADD_SPELL_EFFECT INT_VAR insert_point = 0 opcode = 206 target = 1 timing = 1 STR_VAR resource = EVAL ~cdusec%class%~ END // for dual-classes
  END

COPY ~divine_remix/spheres/template.spl~ ~override/cdusec0.spl~
  PATCH_FOR_EACH class IN 3 8 14 15 17 18 BEGIN
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 326 target = 1 timing = 1 parameter1 = class parameter2 = 105 STR_VAR resource = EVAL ~cdusec%class%~ END
  END
  LPF ADD_SPELL_EFFECT INT_VAR insert_point = 0 opcode = 321 target = 1 timing = 1 STR_VAR resource = cdusec3 END // for dual-classes

OUTER_SET $classkit("clabpr01") = 0
OUTER_SET $classkit("clabfi01") = 0
OUTER_SET $classkit("clabth01") = 0
OUTER_SET $classkit("clabrn01") = 0
OUTER_SET $classkit("clabma01") = 0
OUTER_SET $classkit("ohtyr")    = 1

ACTION_PHP_EACH classkit AS table => foo BEGIN

  ACTION_IF FILE_EXISTS_IN_GAME ~%table%.2da~ BEGIN
    ACTION_IF !foo BEGIN // tyr exception
      APPEND ~%table%.2da~ ~USABILITY AP_cdusek3 CDREPLACE~ UNLESS ~[ %TAB%]+AP_cduse[ck][0-9]+[ %TAB%]+~
    END ELSE BEGIN
      APPEND ~%table%.2da~ ~USABILITY AP_cdusec0 CDREPLACE~ UNLESS ~[ %TAB%]+AP_cduse[ck][0-9]+[ %TAB%]+~
    END
    COPY_EXISTING ~%table%.2da~ ~override~
      COUNT_2DA_COLS cols
      FOR (index = 3 ; index < cols ; ++index) BEGIN
        REPLACE_TEXTUALLY ~CDREPLACE~ ~**** CDREPLACE~
      END
      REPLACE_TEXTUALLY ~CDREPLACE~ ~****~
      PRETTY_PRINT_2DA
      BUT_ONLY
  END
END

COPY_EXISTING ~weapprof.2da~ ~override~
  COUNT_2DA_COLS columns
  SET_2DA_ENTRY 0 0 (columns - 1) ~CDREPLACEME ID~
  READ_2DA_ENTRIES_NOW weapprof columns
  FOR (col = 0 ; col < columns ; ++col) BEGIN
    READ_2DA_ENTRY_FORMER weapprof 0 col header
    PATCH_IF (("%header%" STRING_COMPARE_CASE "A#FEYWARDEN" = 0) OR // feywardens now have access to all weapons
              ("%header%" STRING_COMPARE_CASE "A#RED" = 0)) BEGIN   // so do holy stratagists
      PATCH_IF ("%header%" STRING_COMPARE_CASE "A#FEYWARDEN" = 0) BEGIN SET pips = 2 END ELSE BEGIN SET pips = 1 END
      FOR (row = 9 ; row < 29 ; ++row) BEGIN
        SET_2DA_ENTRY_LATER wp_done row col pips
      END
    END
    PATCH_IF (("%header%" STRING_COMPARE_CASE "OHTYR" = 0) OR     // holy justices get long and bastard swords
              ("%header%" STRING_COMPARE_CASE "CDTYR" = 0)) BEGIN
      SET_2DA_ENTRY_LATER wp_done  9 col 1
      SET_2DA_ENTRY_LATER wp_done 10 col 1
    END
    PATCH_IF ("%header%" STRING_COMPARE_CASE "a#cyric" = 0) BEGIN // stifeleaders get long swords
      SET_2DA_ENTRY_LATER wp_done 10 col 1
    END
    PATCH_IF ("%header%" STRING_COMPARE_CASE "nmsune" = 0) BEGIN // heartwarders get darts
      SET_2DA_ENTRY_LATER wp_done 27 col 1
    END
    PATCH_IF ("%header%" STRING_COMPARE_CASE "a#ogma" = 0) BEGIN // lorekeepers can't use shields, so no S&S style
      SET_2DA_ENTRY_LATER wp_done 30 col 0
    END
  END
  SET_2DA_ENTRIES_NOW wp_done cols
  REPLACE_TEXTUALLY ~CDREPLACEME[ %TAB%]+ID~ ~ID~
  BUT_ONLY

OUTER_SPRINT match_neg  @300002 // ~^Disadvantages:~
OUTER_SPRINT match_pos  @300003 // ~^\(Abilities\|Advantages\):~
OUTER_SPRINT match_none @300011 // ~– None~
OUTER_SPRINT new @300005 // ~– Can use long and bastard swords~
ACTION_FOR_EACH tyrkit IN cdtyr ohtyr BEGIN
  ACTION_IF VARIABLE_IS_SET $kitdesc("%tyrkit%") BEGIN //OR VARIABLE_IS_SET $kitdesc("cdtyr") BEGIN

    ACTION_GET_STRREF $kitdesc("%tyrkit%") desc
    OUTER_INNER_PATCH_SAVE desc ~%desc%~ BEGIN
      REPLACE_TEXTUALLY ~\(%match_pos%\)~ ~\1%LNL%%new%~
    END
    STRING_SET_EVALUATE $kitdesc("%tyrkit%") ~%desc%~

  END
END

OUTER_SPRINT new @300006 // ~– Can use any weapon available to rangers~
ACTION_FOR_EACH tyrkit IN ~a#red~ ~a#feyw~ BEGIN
  ACTION_IF VARIABLE_IS_SET $kitdesc("%tyrkit%") BEGIN

    ACTION_GET_STRREF $kitdesc("%tyrkit%") desc
    OUTER_INNER_PATCH_SAVE desc ~%desc%~ BEGIN
      REPLACE_TEXTUALLY ~\(%match_pos%\)~ ~\1%LNL%%new%~
    END
    STRING_SET_EVALUATE $kitdesc("%tyrkit%") ~%desc%~

  END
END

OUTER_SPRINT new @300006 // ~– Can use long swords~
 ACTION_IF VARIABLE_IS_SET $kitdesc("a#cyric") BEGIN

  ACTION_GET_STRREF $kitdesc("a#cyric") desc
  OUTER_INNER_PATCH_SAVE desc ~%desc%~ BEGIN
    REPLACE_TEXTUALLY ~\(%match_pos%\)~ ~\1%LNL%%new%~
  END
  STRING_SET_EVALUATE $kitdesc("a#cyric") ~%desc%~

END

OUTER_SPRINT new @300007 // ~– Can use darts~
 ACTION_IF VARIABLE_IS_SET $kitdesc("nmsune") BEGIN

  ACTION_GET_STRREF $kitdesc("nmsune") desc
  OUTER_INNER_PATCH_SAVE desc ~%desc%~ BEGIN
    REPLACE_TEXTUALLY ~\(%match_pos%\)~ ~\1%LNL%%new%~
  END
  STRING_SET_EVALUATE $kitdesc("nmsune") ~%desc%~

END

OUTER_SPRINT new @300008 // ~– Cannot wear armor~
 ACTION_IF VARIABLE_IS_SET $kitdesc("cdilmatr") BEGIN

  ACTION_GET_STRREF $kitdesc("cdilmatr") desc
  OUTER_INNER_PATCH_SAVE desc ~%desc%~ BEGIN
    REPLACE_TEXTUALLY ~\(%match_neg%\)~ ~\1%LNL%%new%~
  END
  STRING_SET_EVALUATE $kitdesc("cdilmatr") ~%desc%~

END

OUTER_SPRINT new @300009 // ~– Cannot wear armor heavier than chain~
ACTION_FOR_EACH tyrkit IN ~a#koss~ ~a#shar~ BEGIN
  ACTION_IF VARIABLE_IS_SET $kitdesc("%tyrkit%") BEGIN

    ACTION_GET_STRREF $kitdesc("%tyrkit%") desc
    OUTER_INNER_PATCH_SAVE desc ~%desc%~ BEGIN
      REPLACE_TEXTUALLY ~\(%match_neg%\)~ ~\1%LNL%%new%~
    END
    STRING_SET_EVALUATE $kitdesc("%tyrkit%") ~%desc%~

  END
END

OUTER_SPRINT new @300010 // ~– Cannot wear armor heavier than splint or use shields~
 ACTION_IF VARIABLE_IS_SET $kitdesc("a#ogma") BEGIN

  ACTION_GET_STRREF $kitdesc("a#ogma") desc
  OUTER_INNER_PATCH_SAVE desc ~%desc%~ BEGIN
    REPLACE_TEXTUALLY ~\(%match_neg%\)\(%LNL%%match_none%\)?~ ~\1%LNL%%new%~
  END
  STRING_SET_EVALUATE $kitdesc("a#ogma") ~%desc%~

END
