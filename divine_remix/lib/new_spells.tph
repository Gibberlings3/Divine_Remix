    LPF ALTER_EFFECT INT_VAR silent = 1 match_opcode = 233 parameter1 = 2 END          // for ds, if present
    LPF ALTER_EFFECT INT_VAR match_opcode = 100 parameter1 = 156 parameter2 = 4 END    // protection from demons > solars

  COPY ~divine_remix/bam/cdprgd1a.bam~ ~override~
