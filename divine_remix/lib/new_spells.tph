  ADD_SPELL ~override/sppr408.spl~ 1 3 CLERIC_PROTECTION_FROM_GOOD_10_FOOT // copied above, so already know it's in the override
    DEFINE_ASSOCIATIVE_ARRAY cd_spell_new BEGIN ~%DEST_RES%~, 0 => 3 END // for spellbook updates
    SAY NAME1 @198
