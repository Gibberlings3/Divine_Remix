    SAY UNIDENTIFIED_DESC @113
    SAY DESC @113
    LPF CD_EXTEND-O-MATIC INT_VAR step_dur = 6 dur_special = 1 step_size = 5 level_cap = dr_level_cap END

  COPY ~divine_remix/bam/cdfaeria.bam~ ~override~
