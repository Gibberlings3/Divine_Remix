ACTION_IF ((overwrite = 1) OR ((IDS_OF_SYMBOL (~spell~ ~CLERIC_DETECT_GOOD~)) < 0)) BEGIN // only if not present or overwrite selected

  COPY_EXISTING ~sppr104.spl~ ~override~
  ADD_SPELL ~override/sppr104.spl~ 1 1 CLERIC_DETECT_GOOD  // detect good
    DEFINE_ASSOCIATIVE_ARRAY cd_spell_new BEGIN ~%DEST_RES%~, 0 => 1 END // for spellbook updates
    SAY NAME1 @194
    SAY NAME2 @194
    SAY UNIDENTIFIED_DESC @195
    SAY DESC @195
    WRITE_ASCII 0x3a cddtgooc #8
    LPF ALTER_HEADER STR_VAR icon = cddtgoob END
    // bg2fp and ee route the actual alignment detection to a subspell so that MR works, so have to account for both methods here
    LPF ALTER_EFFECT INT_VAR silent = 1 match_opcode = 146 STR_VAR match_resource = cddetevl resource = cddetgod END // if ee/bg2fp
    LPF ALTER_EFFECT INT_VAR silent = 1 match_opcode = 115 match_parameter2 = 0 parameter2 = 2 END                   // if old
    
  ACTION_IF FILE_EXISTS_IN_GAME ~cddetevl.spl~ BEGIN
    COPY_EXISTING ~cddetevl.spl~ ~override/cddetgod.spl~
      LPF ALTER_EFFECT INT_VAR silent = 1 match_opcode = 115 match_parameter2 = 0 parameter2 = 2 END
  END 

  COPY ~divine_remix/bam/cddtgooa.bam~ ~override~
       ~divine_remix/bam/cddtgoob.bam~ ~override~
       ~divine_remix/bam/cddtgooc.bam~ ~override~

END

ACTION_IF ((overwrite = 1) OR ((IDS_OF_SYMBOL (~spell~ ~CLERIC_DIVINE_SHELL~)) < 0)) BEGIN // only if not present or overwrite selected

  // use existing pfnm as a base for projectile blocking so that we don't have to account for ee vs. obg2 with or without 1pp
  COPY_EXISTING ~spwi311.spl~ ~override~
    READ_LONG  0x64 abil_off
    READ_SHORT 0x68 abil_num
    READ_LONG  0x6a fx_off
    FOR (index = 0 ; index < abil_num ; ++index) BEGIN
      READ_SHORT (abil_off + 0x1e + (0x28 * index)) abil_fx_num
      READ_SHORT (abil_off + 0x20 + (0x28 * index)) abil_fx_idx
      FOR (index2 = 0 ; index2 < abil_fx_num ; ++index2) BEGIN
        READ_SHORT (fx_off + 0x00 + (0x30 * (abil_fx_idx + index2))) op
        PATCH_IF op = 83 BEGIN // immunity to projectile
          READ_LONG (fx_off + 0x08 + (0x30 * (abil_fx_idx + index2))) proj
          DEFINE_ASSOCIATIVE_ARRAY cd_pfnm BEGIN ~%proj%~ => 0 END
        END
      END
    END
    BUT_ONLY    
    
  ADD_SPELL ~divine_remix/spl/cddshel.spl~ 1 6 CLERIC_DIVINE_SHELL  // divine shell
    DEFINE_ASSOCIATIVE_ARRAY cd_spell_new BEGIN ~%DEST_RES%~, 0 => 6 END // for spellbook updates
    SAY NAME1 @166
    SAY NAME2 @166
    SAY UNIDENTIFIED_DESC @167
    SAY DESC @167
    PATCH_PHP_EACH cd_pfnm AS proj => foo BEGIN
      LPF CLONE_EFFECT INT_VAR match_opcode = 0 opcode = 83 parameter1 = 0 parameter2 = proj END
    END  

  COPY ~divine_remix/bam/cddshela.bam~ ~override~
       ~divine_remix/bam/cddshelb.bam~ ~override~
       ~divine_remix/bam/cddshelc.bam~ ~override~

END

