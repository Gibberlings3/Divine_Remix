  ADD_SPELL ~divine_remix/spl/nmcausbd.spl~ 1 3 CLERIC_CAUSE_BLINDNESS_OR_DEAFNESS // cause blindness or deafness
    DEFINE_ASSOCIATIVE_ARRAY cd_spell_new BEGIN ~%DEST_RES%~, 0 => 3 END // for spellbook updates
    SAY NAME1 @181
    SAY NAME2 @181
    SAY UNIDENTIFIED_DESC @182
    SAY DESC @182
  
  COPY ~divine_remix/bam/nmcausba.bam~ ~override~
       ~divine_remix/bam/nmcausbb.bam~ ~override~
       ~divine_remix/bam/nmcausbc.bam~ ~override~

END

// CLERIC_CURE_BLIND_DEAF has a spell.ids entry, but no spell, so the check is a bit more complicated
OUTER_SET install_nmcurebd = 0
ACTION_IF overwrite BEGIN 
  OUTER_SET install_nmcurebd = 1 // if we're in overwrite mode, install anyway
END ELSE BEGIN
  ACTION_IF IDS_OF_SYMBOL (~spell~ ~CLERIC_CURE_BLIND_DEAF~) < 0 BEGIN
    OUTER_SET install_nmcurebd = 1 // if no spell.ids entry, install
  END ELSE BEGIN  
    LAF RES_NAME_OF_SPELL_NUM INT_VAR spell_num = IDS_OF_SYMBOL (~spell~ ~CLERIC_CURE_BLIND_DEAF~) RET spell_res END
    ACTION_IF !FILE_EXISTS_IN_GAME ~%spell_res%.spl~ BEGIN OUTER_SET install_nmcurebd = 1 END // if existing spell.ids entry but no actual spell, install
  END
END  

