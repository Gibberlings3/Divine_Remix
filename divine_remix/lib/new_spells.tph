// CLERIC_ENERGY_DRAIN has a spell.ids entry, but no spell, so the check is a bit more complicated
OUTER_SET install_nmcurebd = 0
ACTION_IF overwrite BEGIN 
  OUTER_SET install_nmcurebd = 1 // if we're in overwrite mode, install anyway
END ELSE BEGIN
  ACTION_IF IDS_OF_SYMBOL (~spell~ ~CLERIC_ENERGY_DRAIN~) < 0 BEGIN
    OUTER_SET install_nmcurebd = 1 // if no spell.ids entry, install
  END ELSE BEGIN  
    LAF RES_NAME_OF_SPELL_NUM INT_VAR spell_num = IDS_OF_SYMBOL (~spell~ ~CLERIC_ENERGY_DRAIN~) RET spell_res END
    ACTION_IF !FILE_EXISTS_IN_GAME ~%spell_res%.spl~ BEGIN OUTER_SET install_nmcurebd = 1 END // if existing spell.ids entry but no actual spell, install
  END
END  

ACTION_IF install_nmcurebd BEGIN 

  COPY_EXISTING ~spwi914.spl~ ~override~

  ADD_SPELL ~override/spwi914.spl~ 1 7 CLERIC_ENERGY_DRAIN
    DEFINE_ASSOCIATIVE_ARRAY cd_spell_new BEGIN ~%DEST_RES%~, 0 => 7 END // for spellbook updates
    WRITE_SHORT 0x1c 2 // change to divine spell
    WRITE_SHORT 0x1e 0 // remove exclusion
    WRITE_SHORT 0x34 7 // change level
    LPF ALTER_EFFECT INT_VAR match_power = 9 power = 7 END
    PATCH_FOR_EACH offset IN 0x50 BEGIN
      READ_LONG ~%offset%~ desc_strref
      PATCH_IF (desc_strref >= 0 && desc_strref < 2147483646) BEGIN
        READ_STRREF ~%offset%~ desc
        INNER_PATCH_SAVE desc ~%desc%~ BEGIN
          REPLACE_TEXTUALLY ~%level_match%~ ~\17%LNL%%sphere_text% %sphere_ne%~ // change level in description to 7, add sphere
        END
      END
      SAY_EVALUATED offset ~%desc%~
    END

END

// disable original spells that were moved to another level
ACTION_IF enhanced_edition BEGIN 

  APPEND ~hidespl.2da~ 
~sppr408 1 0 0
sppr413 1 0 0~

  ACTION_IF VARIABLE_IS_SET ~%CLERIC_DIVINE_SHELL%~ BEGIN // if this was installed

    // copy new portrait icons for divine shell
    COPY ~divine_remix/bam/cddsheld.bam~ ~override~
    LAF cd_new_portrait_icon INT_VAR string = RESOLVE_STR_REF(@166) STR_VAR bam_file = cddsheld RET cddsheld = icon END
    LAF RES_NUM_OF_SPELL_NAME STR_VAR spell_name = CLERIC_DIVINE_SHELL RET spell_res END  
    COPY_EXISTING ~%spell_res%.spl~ ~override~
      LPF DELETE_EFFECT INT_VAR multi_match = 4 match_opcode = 142 END 
      LPF ALTER_EFFECT INT_VAR match_opcode = 142 parameter2 = cddsheld END
  
  END
  
  ACTION_IF VARIABLE_IS_SET ~%CLERIC_PROTECT_FROM_GOOD_TEMP%~ BEGIN // if this was installed
  
    COPY ~divine_remix/bam/cdprgood.bam~ ~override~
    LAF cd_new_portrait_icon INT_VAR string = RESOLVE_STR_REF(@208) STR_VAR bam_file = cdprgood RET cdprgood = icon END
    LAF RES_NUM_OF_SPELL_NAME STR_VAR spell_name = CLERIC_PROTECT_FROM_GOOD RET spell_res END  
    COPY_EXISTING ~%spell_res%.spl~ ~override~
      LPF ALTER_EFFECT INT_VAR match_opcode = 142 match_parameter2 = 9 parameter2 = cdprgood END
  END  
  
  ACTION_IF VARIABLE_IS_SET ~%CLERIC_PROTECTION_FROM_GOOD_10_FOOT%~ BEGIN // if this was installed
    
    ACTION_IF !FILE_EXISTS_IN_GAME ~cdprgood.bam~ BEGIN 
      COPY ~divine_remix/bam/cdprgood.bam~ ~override~
      LAF cd_new_portrait_icon INT_VAR string = RESOLVE_STR_REF(@208) STR_VAR bam_file = cdprgood RET cdprgood = icon END
    END
    LAF RES_NUM_OF_SPELL_NAME STR_VAR spell_name = CLERIC_PROTECTION_FROM_GOOD_10_FOOT RET spell_res END  
    COPY_EXISTING ~%spell_res%.spl~ ~override~
      LPF ALTER_EFFECT INT_VAR match_opcode = 142 match_parameter2 = 9 parameter2 = cdprgood END
    
  END   
  
END ELSE BEGIN

  COPY_EXISTING ~sppr408.spl~ ~override~
                ~sppr413.spl~ ~override~
    WRITE_BYTE 0x21 (THIS BOR (BIT6 + BIT7)) // don't show up automatically in spellbooks
    BUT_ONLY
    
  ACTION_IF VARIABLE_IS_SET ~%CLERIC_PROTECT_FROM_GOOD_TEMP%~ OR VARIABLE_IS_SET ~%CLERIC_PROTECTION_FROM_GOOD_10_FOOT%~ BEGIN // if this was installed

    COPY_EXISTING ~statdesc.2da~ ~override~ // changes Protected from Evil icon description to Protection from Alignment
      SET newtext = RESOLVE_STR_REF(@206)
      REPLACE_TEXTUALLY ~^9[ %TAB%]+[0-9]+~ ~9 %newtext%~
      PRETTY_PRINT_2DA

  END

END

INCLUDE ~%MOD_FOLDER%/lib/joinable_npc_array.tpa~

ACTION_PHP_EACH JOINABLE_NPC_ARRAY AS file => dv BEGIN

  ACTION_IF !IS_AN_INT dv BEGIN // joinable NPC

    COPY_EXISTING ~%file%~ ~override~
      READ_BYTE 0x273 class
      READ_LONG 0x2ac minfo_num
      PATCH_IF ((minfo_num = 17) AND // sanity check - don't proceed unless the full memorization array is present
                ((class =  3) OR      // cleric
                 (class =  6) OR      // paladin
                 (class =  8) OR      // fighter-cleric
                 (class = 11) OR      // druid
                 (class = 12) OR      // ranger
                 (class = 14) OR      // cleric-mage
                 (class = 15) OR      // cleric-thief
                 (class = 16) OR      // fighter-druid
                 (class = 17) OR      // f-mcc
                 (class = 18) OR      // cleric-ranger
                 (class = 21))) BEGIN // shaman
        READ_LONG 0x2a0 known_off // basic offsets and info
        READ_LONG 0x2a4 known_num
        READ_LONG 0x2a8 minfo_off
        READ_LONG 0x2b0 mem_off
        READ_LONG 0x2b4 mem_num
        CLEAR_ARRAY cd_spell_new_working // reset vars
        SET new_known = 0
        // go through memorized spells
        // first, add new spells to known
        SET maxlevel = "-1"
        FOR (index = 6 ; index >= 0 ; --index) BEGIN 
          READ_SHORT (minfo_off + 0x02 + (index * 0x10)) check
          PATCH_IF check BEGIN 
            SET maxlevel = index + 1
            SET index = 0 // kill loop
          END
        END
        // params_1 is meant to check for restrictions, but none of these have restrictions, so
        PATCH_IF maxlevel >= 0 BEGIN 
          PATCH_PHP_EACH cd_spell_new AS params => level BEGIN
            PATCH_IF maxlevel >= level BEGIN
              DEFINE_ASSOCIATIVE_ARRAY cd_spell_new_working BEGIN ~%params_0%~ => ~%level%~ END
            END
          END
        END
        // next, sub changed spells
        PATCH_PHP_EACH cd_spell_sub AS params => old BEGIN
          SET matched = 0
          READ_LONG (minfo_off + 0x08 + (params_1 * 0x10)) mem_tbl_idx
          READ_LONG (minfo_off + 0x0c + (params_1 * 0x10)) mem_tbl_num
          FOR (index = 0 ; index < mem_tbl_num ; ++index) BEGIN
            READ_ASCII (mem_off + 0x00 + ((index + mem_tbl_idx) * 0x0c)) spell
            PATCH_IF ("%old%" STRING_COMPARE_CASE "%spell%" = 0) BEGIN // matched
              WRITE_ASCIIE (mem_off + 0x00 + ((index + mem_tbl_idx) * 0x0c)) ~%params_3%~ #8 // replacement spell at old level
              SET matched = 1
            END
          END        
          PATCH_IF matched BEGIN // if they had the old spell memorized, add it to the new level's memorization
            READ_LONG (minfo_off + 0x0c + (params_2 * 0x10)) mem_tbl_num
            PATCH_IF mem_tbl_num BEGIN // sanity check, make sure they actually know some spells here
              SET select = RANDOM(0 (mem_tbl_num - 1))
              READ_LONG (minfo_off + 0x08 + (params_2 * 0x10)) mem_tbl_idx
              WRITE_ASCIIE (mem_off + 0x00 + ((select + mem_tbl_idx) * 0x0c)) ~%params_0%~ #8 // replace a random spell at the new level with the new spell
            END
          END 
        END
      
        // go through known spells and sub new for old
        FOR (index = 0 ; index < known_num ; ++index) BEGIN
          READ_ASCII (known_off + 0x00 + (index * 0x0c)) spell
          PATCH_PHP_EACH cd_spell_sub AS params => old BEGIN
            PATCH_IF ("%old%" STRING_COMPARE_CASE "%spell%" = 0) BEGIN // matched
              WRITE_ASCIIE (known_off + 0x00 + (index * 0x0c)) ~%params_0%~ #8 // updated resref
              WRITE_SHORT  (known_off + 0x08 + (index * 0x0c)) ~%params_2%~    // updated level
            END
          END
        END
        // now add new known spells
        PATCH_PHP_EACH cd_spell_new_working AS spell => level BEGIN
          INSERT_BYTES known_off 0x0c
          WRITE_ASCIIE (known_off + 0x00) ~%spell%~
          WRITE_SHORT  (known_off + 0x08) (level - 1) // last short is type, but 0 = priest
          SET new_known += 1
        END 
        PATCH_IF new_known BEGIN
          WRITE_LONG 0x2a4 known_num + new_known
          PATCH_FOR_EACH off IN 0x2a8 0x2b0 0x2b8 0x2bc 0x2c4 BEGIN
            READ_LONG off offcheck
            PATCH_IF offcheck > known_off BEGIN
              WRITE_LONG off (THIS + (0x0c * new_known))
            END
          END
        END    
      END
      BUT_ONLY  
      
  END

END 
