// iwdee mytos already has a CLERIC_PROTECT_FROM_GOOD, but it's outside of the usable spells for player clerics
OUTER_SET cpfg = IDS_OF_SYMBOL (~spell~ ~CLERIC_PROTECT_FROM_GOOD~)
ACTION_IF ((overwrite = 1) OR (cpfg < 0) OR (cpfg = 1199)) BEGIN // only if not present or overwrite selected

  ACTION_IF cpfg = 1199 BEGIN // iwdee with mytos
    
    COPY_EXISTING ~sppr199.spl~ ~override~ // descripiton, effects already fine
    ADD_SPELL ~override/sppr199.spl~ 1 1 CLERIC_PROTECT_FROM_GOOD_TEMP
      DEFINE_ASSOCIATIVE_ARRAY cd_spell_new BEGIN ~%DEST_RES%~, 0 => 1 END // for spellbook updates
      WRITE_ASCII 0x3a cdprgooc #8
      LPF ALTER_HEADER STR_VAR icon = cdprgoob END
      LPF ALTER_EFFECT STR_VAR match_resource = sppr199 resource = EVAL ~%DEST_RES%~ END
      
  END ELSE BEGIN    

    COPY_EXISTING ~sppr107.spl~ ~override~
    ADD_SPELL ~override/sppr107.spl~ 1 1 CLERIC_PROTECT_FROM_GOOD_TEMP
      DEFINE_ASSOCIATIVE_ARRAY cd_spell_new BEGIN ~%DEST_RES%~, 0 => 1 END // for spellbook updates
      SAY NAME1 @196
      SAY NAME2 @196
      SAY UNIDENTIFIED_DESC @197
      SAY DESC @197
      WRITE_ASCII 0x3a cdprgooc #8
      LPF ALTER_HEADER STR_VAR icon = cdprgoob END
      LPF ALTER_EFFECT INT_VAR match_opcode = 139 parameter1 = RESOLVE_STR_REF(@201) END // "protected from good"
      LPF ALTER_EFFECT INT_VAR match_opcode = 219 parameter1 = 1 END                     // change alignment for attack penalty
      LPF ALTER_EFFECT INT_VAR silent = 1 match_opcode = 233 parameter1 = 2 END          // for ds, if present
      LPF ALTER_EFFECT INT_VAR match_opcode = 100 parameter1 = 156 parameter2 = 4 END    // protection from demons > solars

  END
  
  COPY_EXISTING ~spell.ids~ ~override~
    REPLACE_TEXTUALLY ~^\(1199[ %TAB%]*CLERIC_PROTECT_FROM_GOOD\)\([ %TAB%%LNL%%MNL%%WNL%]+\)~ ~\1_MYTOS\2~ // rename existing entry (iwdee)
    REPLACE_TEXTUALLY ~^\(11[0-9][0-9][ %TAB%]*CLERIC_PROTECT_FROM_GOOD\)_TEMP\([ %TAB%%LNL%%MNL%%WNL%]+\)~ ~\1\2~ // rename new spell entry
  
  COPY ~divine_remix/bam/cdprgooa.bam~ ~override~
       ~divine_remix/bam/cdprgoob.bam~ ~override~
       ~divine_remix/bam/cdprgooc.bam~ ~override~

END

