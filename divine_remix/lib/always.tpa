OUTER_SET cd_divine_remix_always = 1 // just do this part once per install

INCLUDE ~divine_remix/lib/game_checks.tpa~   // sets game_is variables
INCLUDE ~divine_remix/lib/macros.tph~        // defines patch macro
INCLUDE ~divine_remix/lib/fl#add_kit_ee.tpa~ // for ee kit features

APPEND ~state.ids~ ~0x00000FC0 STATE_REALLY_DEAD~ UNLESS ~0x00000FC0 STATE_REALLY_DEAD~
APPEND ~spell.ids~ ~1718 CLERIC_SYMBOL_STUN~  UNLESS ~CLERIC_SYMBOL_STUN~
APPEND ~spell.ids~ ~1719 CLERIC_SYMBOL_DEATH~ UNLESS ~CLERIC_SYMBOL_DEATH~

ACTION_IF !enhanced_edition BEGIN 

  // eefixpack spell immunity states
  OUTER_SET charm_immunity     = "-1"
  OUTER_SET confusion_immunity = "-1"
  OUTER_SET death_immunity     = "-1"
  OUTER_SET entangle_immunity  = "-1"
  OUTER_SET haste_immunity     = "-1"
  OUTER_SET hold_immunity      = "-1"
  OUTER_SET panic_immunity     = "-1"
  OUTER_SET silence_immunity   = "-1"
  OUTER_SET sleep_immunity     = "-1"
  OUTER_SET slow_immunity      = "-1"
  OUTER_SET web_immunity       = "-1"
  
  OUTER_SPRINT tra_path ~divine_remix/languages~
  
  INCLUDE ~divine_remix/lib/kit_ids_fixer.tpa~ // for ee kit features
  ACTION_IF !game_includes_tob BEGIN 
    INCLUDE ~divine_remix/lib/tob2soa.tpa~ // for ee kit features
  END
  
END ELSE BEGIN  

   // eefixpack spell immunity states
  OUTER_SET charm_immunity     = IDS_OF_SYMBOL (~splstate~ ~CHARM_IMMUNITY~)
  OUTER_SET confusion_immunity = IDS_OF_SYMBOL (~splstate~ ~CONFUSION_IMMUNITY~)
  OUTER_SET death_immunity     = IDS_OF_SYMBOL (~splstate~ ~DEATH_IMMUNITY~)
  OUTER_SET entangle_immunity  = IDS_OF_SYMBOL (~splstate~ ~ENTANGLE_IMMUNITY~)
  OUTER_SET haste_immunity     = IDS_OF_SYMBOL (~splstate~ ~HASTE_IMMUNITY~)
  OUTER_SET hold_immunity      = IDS_OF_SYMBOL (~splstate~ ~HOLD_IMMUNITY~)
  OUTER_SET panic_immunity     = IDS_OF_SYMBOL (~splstate~ ~PANIC_IMMUNITY~)
  OUTER_SET silence_immunity   = IDS_OF_SYMBOL (~splstate~ ~SILENCE_IMMUNITY~)
  OUTER_SET sleep_immunity     = IDS_OF_SYMBOL (~splstate~ ~SLEEP_IMMUNITY~)
  OUTER_SET slow_immunity      = IDS_OF_SYMBOL (~splstate~ ~SLOW_IMMUNITY~)
  OUTER_SET web_immunity       = IDS_OF_SYMBOL (~splstate~ ~WEB_IMMUNITY~)
  
  OUTER_SPRINT tra_path ~weidu_external/divine_remix/languages~

  ACTION_DEFINE_ARRAY cdnoconvert BEGIN weidu game_ee END
  ACTION_DEFINE_ARRAY cdreload BEGIN game END
  LAF HANDLE_CHARSETS
    INT_VAR
      infer_charsets = 1
    STR_VAR
      tra_path = ~divine_remix/languages~
      out_path = ~weidu_external/divine_remix/languages~
      noconvert_array = cdnoconvert
      reload_array = cdreload
  END
  
  LOAD_TRA ~divine_remix/languages/%LANGUAGE%/game_ee.tra~

END  

ACTION_IF NOT VARIABLE_IS_SET charm_immunity THEN BEGIN // ee fixpack immunity spellstates

  ACTION_IF enhanced_edition BEGIN

    OUTER_SET charm_immunity     = IDS_OF_SYMBOL (~splstate~ ~CHARM_IMMUNITY~)
    OUTER_SET confusion_immunity = IDS_OF_SYMBOL (~splstate~ ~CONFUSION_IMMUNITY~)
    OUTER_SET death_immunity     = IDS_OF_SYMBOL (~splstate~ ~DEATH_IMMUNITY~)
    OUTER_SET entangle_immunity  = IDS_OF_SYMBOL (~splstate~ ~ENTANGLE_IMMUNITY~)
    OUTER_SET haste_immunity     = IDS_OF_SYMBOL (~splstate~ ~HASTE_IMMUNITY~)
    OUTER_SET hold_immunity      = IDS_OF_SYMBOL (~splstate~ ~HOLD_IMMUNITY~)
    OUTER_SET panic_immunity     = IDS_OF_SYMBOL (~splstate~ ~PANIC_IMMUNITY~)
    OUTER_SET silence_immunity   = IDS_OF_SYMBOL (~splstate~ ~SILENCE_IMMUNITY~)
    OUTER_SET sleep_immunity     = IDS_OF_SYMBOL (~splstate~ ~SLEEP_IMMUNITY~)
    OUTER_SET slow_immunity      = IDS_OF_SYMBOL (~splstate~ ~SLOW_IMMUNITY~)
    OUTER_SET web_immunity       = IDS_OF_SYMBOL (~splstate~ ~WEB_IMMUNITY~)

  END ELSE BEGIN

    OUTER_SET charm_immunity     = "-1"
    OUTER_SET confusion_immunity = "-1"
    OUTER_SET death_immunity     = "-1"
    OUTER_SET entangle_immunity  = "-1"
    OUTER_SET haste_immunity     = "-1"
    OUTER_SET hold_immunity      = "-1"
    OUTER_SET panic_immunity     = "-1"
    OUTER_SET silence_immunity   = "-1"
    OUTER_SET sleep_immunity     = "-1"
    OUTER_SET slow_immunity      = "-1"
    OUTER_SET web_immunity       = "-1"

  END

END

ACTION_IF game_is_iwdee BEGIN OUTER_SET dr_level_cap = 30 END ELSE BEGIN OUTER_SET dr_level_cap = 20 END
OUTER_SPRINT name_cleric @10155 // Cleric - used for name replacements on creatures
OUTER_SPRINT name_priest @10156 // Priest/Priestess - used for name replacements on creatures
OUTER_SPRINT holy_symbol_stats @216 // used to fill out holy symbol descriptions

CLEAR_IDS_MAP
