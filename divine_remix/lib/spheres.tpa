/////                                                  \\\\\
///// create sphere framework                          \\\\\
/////                                                  \\\\\

INCLUDE ~divine_remix/spheres/spell_list_processing.tpa~

/////                                                  \\\\\
///// read tables to determine when spells issued      \\\\\
/////                                                  \\\\\

ACTION_DEFINE_ASSOCIATIVE_ARRAY cd_table_lookups BEGIN

  druid   => mxspldru
  cleric  => mxsplprs
  paladin => mxsplpal
  ranger  => mxsplran

END

ACTION_PHP_EACH cd_table_lookups AS class => table BEGIN

  ACTION_IF FILE_EXISTS_IN_GAME ~%table%.2da~ THEN BEGIN
    
    ACTION_CLEAR_ARRAY cd_spell_avail
    COPY_EXISTING ~%table%.2da~ ~override~
      FOR (index = 1 ; index < 8 ; ++index) BEGIN
        COUNT_2DA_ROWS (index + 1) rows
        PATCH_IF (index = 1) BEGIN SET start = 2 END ELSE BEGIN SET start = 1 END
        FOR (index2 = start ; index2 < rows ; ++index2) BEGIN
          READ_2DA_ENTRY index2 index (index + 1) val
          PATCH_IF (val > 0) BEGIN
            READ_2DA_ENTRY index2 0 (index + 1) level
            SET $cd_spell_avail("CDREPLACE%index%") = level
            SET index2 = rows // kill loop
          END
        END
      END
      BUT_ONLY

    COPY ~divine_remix/spheres/template.2da~ ~weidu_external/divine_remix/spheres/%class%.2da~
      PATCH_PHP_EACH cd_spell_avail AS entry => level BEGIN
        SET_2DA_ENTRY 0 level 50 ~%entry%~
      END  
      
  END

END

ACTION_IF NOT FILE_EXISTS ~weidu_external/divine_remix/spheres/druid.2da~ THEN BEGIN

  COPY ~weidu_external/divine_remix/spheres/cleric.2da~ ~weidu_external/divine_remix/spheres/druid.2da~

END

/////                                                  \\\\\
///// create sphere clab templates, spells             \\\\\
/////                                                  \\\\\

ACTION_PHP_EACH cd_spheres_definitions AS sphinfo => long BEGIN           

  ACTION_PHP_EACH cd_table_lookups AS class => table BEGIN

    COPY ~weidu_external/divine_remix/spheres/%class%.2da~ ~weidu_external/divine_remix/spheres/%class%_%sphinfo_0%_major.2da~
      REPLACE_TEXTUALLY ~CDREPLACE\([1-7]\)~ ~AP_CDDR%sphinfo_0%\1~

    COPY ~weidu_external/divine_remix/spheres/%class%_%sphinfo_0%_major.2da~ ~weidu_external/divine_remix/spheres/%class%_%sphinfo_0%_minor.2da~
      REPLACE_TEXTUALLY ~AP_CDDR%sphinfo_0%[4-7]~ ~****~ // delete levels 4-7 for minor access

  END
  
  OUTER_FOR (index = 1 ; index < 8 ; ++index) BEGIN
  
    COPY ~divine_remix/spheres/template.spl~ ~override/cddr%sphinfo_0%%index%.spl~
      PATCH_PHP_EACH cd_spheres_spell_info AS params => spell BEGIN
        PATCH_IF ((("%sphinfo_0%" STRING_COMPARE_CASE "%params_1%" = 0) OR   // working sphere matches spell's primary
                   ("%sphinfo_0%" STRING_COMPARE_CASE "%params_2%" = 0) OR   // secondary
                   ("%sphinfo_0%" STRING_COMPARE_CASE "%params_3%" = 0)) AND // or tertiary sphere
                  (index = params_5)) BEGIN // level matches
          LPF NAME_NUM_OF_SPELL_RES STR_VAR spell_res = EVAL ~%spell%~ RET spell_num END
          SET working = spell_num - 1000
          LPM cd_dr_spell_exclusions
        END // sphere/level check
      END // php_each        
  
  END // outer_for
  
END // ACTION_FOR_EACH sphere iterations

