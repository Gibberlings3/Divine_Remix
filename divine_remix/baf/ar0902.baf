
IF
  Global("TelwynSent","GLOBAL",1)
  !Global("SainSpawn","GLOBAL",1)
THEN
  RESPONSE #100
    SetGlobal("SainSpawn","GLOBAL",1)
    CreateCreature("SCSAIN",[642.627],0)  // Dawnbringer Sain
    ActionOverride("scsain",SetNumTimesTalkedTo(1))
END

IF
  Global("CDWorkingForHelm","GLOBAL",1)
  !Global("TelwynSent","GLOBAL",1)
  OR(2)
    !Global("SainSpawn","GLOBAL",2)
    !Global("CDSpawnArval","GLOBAL",3)
THEN
  RESPONSE #100
    SetGlobal("SainSpawn","GLOBAL",2)
    SetGlobal("CDSpawnArval","GLOBAL",3)
    ActionOverride("SCSAIN",DestroySelf())
    ActionOverride("Arval",DestroySelf())
END

IF
  Global("CDSpawnArval","GLOBAL",1)
  Global("CDWorkingForHelm","GLOBAL",0)
THEN
  RESPONSE #100
    SetGlobal("CDSpawnArval","GLOBAL",2)
    CreateCreature("BHARVAL",[577.650],12)  // High Mornmaster Arval
    ActionOverride("arval",SetNumTimesTalkedTo(1))
END

IF
  Global("OHHelmOverride","GLOBAL",0)
  Global("OHTalosOverride","GLOBAL",0)
  Global("SainSpawn","GLOBAL",0)
  OR(4)
    Global("OHLathanderOverride","GLOBAL",1)
    Alignment(Player1,MASK_GOOD)
    Alignment(Player1,NEUTRAL)
    Kit(Player1,GODLATHANDER)
  Class(Player1,CLERIC_ALL)
  !Kit(Player1,GODHELM)
  !Kit(Player1,GODTALOS)
  !Global("cd_beholder_dc_shenanigans","GLOBAL",1)
THEN
  RESPONSE #100
    SetGlobal("SainSpawn","GLOBAL",1)
    CreateCreature("SCSAIN",[642.627],0)  // Dawnbringer Sain
END