ACTION_IF !VARIABLE_IS_SET cd_spell_list_processing BEGIN

  OUTER_SET cd_spell_list_processing = 1
  
  INCLUDE ~divine_remix/spheres/spell_list.tpa~      // manual lookup table
  INCLUDE ~divine_remix/lib/modder_strings.tpa~      // sets vars from strings
  INCLUDE ~divine_remix/lib/modder_spell.tpa~        // defines macros for patches below
  INCLUDE ~divine_remix/lib/spheres_definitions.tpa~ // defines spheres
  INCLUDE ~divine_remix/lib/spheres_hidespl.tpa~     // processes hidespl
  OUTER_SET dr_external_mode = 0
  
  // attempt to build spheres from unknown spells
  COPY_EXISTING_REGEXP GLOB ~^sppr[1-7][0-4][0-9]\.spl$~ ~override~
    LPM cd_dr_spell_macro
    BUT_ONLY  

END
