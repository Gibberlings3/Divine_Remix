    charm                   = major
    combat                  = major
    divination              = minor
    elemental               = minor
    elemental_air           = minor
    elemental_earth         = minor
    elemental_fire          = minor
    elemental_water         = minor
    guardian                = major
    healing                 = major
    necromantic             = major
    necromantic_restorative = major
    numbers                 = minor
    protection              = minor
    summoning               = major
    sun                     = major
    time                    = major
    war                     = major
    weather                 = major
  END
