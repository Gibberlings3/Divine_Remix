    chaos                   = major
    combat                  = major
    divination              = major
    elemental               = major
    elemental_air           = major
    elemental_earth         = major
    elemental_fire          = major
    elemental_water         = major
    guardian                = minor
    healing                 = major
    necromantic             = major
    necromantic_restorative = major
    protection              = major
    summoning               = minor
    sun                     = minor
    war                     = major
    wards                   = minor
    weather                 = major
  END
